---
/**
 * Two sections.
 *
 * The panel mirrors the hero — same shell measure, same rounded box, same
 * dashed rules above and below, same shader behind it — so the page opens and
 * closes on the same object. Content in it is a placeholder for now.
 *
 * Below that, the full-width strip that was already here: credits, trading
 * details, secondary links.
 *
 * Last, the wordmark: the name set huge in outline across the content
 * measure, cropped by the bottom of the page so it reads as rising out of
 * it. Sized in container units so it always spans the measure exactly.
 */
import HeroShader from "./HeroShader";
import FloatingIcons from "./FloatingIcons.astro";
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="mt-3 sm:mt-4">
  {/* ── 1. Panel ─────────────────────────────────────────────────────── */}
  <section class="flex flex-col gap-3 sm:gap-4">
    <div class="rule-dashed" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-shell px-6 lg:px-10">
      <div class="fpanel relative isolate flex flex-col justify-end min-h-[32rem] overflow-hidden rounded-[20px] border border-rule">
        {/* client:visible, not client:load: this sits at the foot of every
            page on the site, and a WebGL context per page is not worth paying
            for before someone has scrolled to it. */}
        <HeroShader client:visible />

        <div
          class="absolute inset-0 z-[1] pointer-events-none bg-gradient-to-t from-paper from-0% via-paper/65 via-38% to-transparent to-72%"
          aria-hidden="true"
        >
        </div>

        {/* Behind the copy, above the scrim. Only from lg up: on narrower
            panels there is no margin to scatter into. */}
        <FloatingIcons side="left" class="hidden lg:block z-[2]" />
        <FloatingIcons side="right" class="hidden lg:block z-[2]" />

        <div class="relative z-10 w-full px-6 sm:px-10 lg:px-14 py-20 sm:py-24">
          <div class="flex justify-center">
            <div class="flex flex-col items-center gap-6 text-center">
              <p class="display text-[clamp(2.5rem,7vw,5rem)] m-0">
                Let's build<span class="text-accent">.</span>
              </p>
              <p class="text-base sm:text-lg text-ink-dim max-w-md">
                Websites, internal tools and automation for small businesses in
                Ireland.
              </p>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="/start/" class="nav-cta fcta">Hire me</a>
                <a
                  href="/contact/"
                  class="link inline-flex items-baseline gap-2 font-mono text-xs uppercase tracking-widest text-ink-dim"
                >
                  Say hi
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rule-dashed" aria-hidden="true"></div>
  </section>

  {/* ── 2. The strip ─────────────────────────────────────────────────── */}
  <div class="mx-auto max-w-6xl px-6 lg:px-10 py-10 flex flex-col gap-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 items-end">
      <div class="font-mono text-xs text-ink-faint tracking-widest uppercase">
        © {year} Dylan Collins
      </div>
      <div class="sm:text-center">
        <a href="/rss.xml" class="link font-mono text-xs text-ink-dim tracking-widest uppercase">RSS</a>
      </div>
      <ul class="flex gap-6 sm:justify-end font-mono text-xs uppercase tracking-widest">
        <li><a href="https://github.com/pyxyll" class="link text-ink-dim" target="_blank" rel="me noopener">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/dylan-c-collins/" class="link text-ink-dim" target="_blank" rel="me noopener">LinkedIn</a></li>
        <li><a href="mailto:hello@dylancollins.me" class="link text-ink-dim" rel="author">Email</a></li>
      </ul>
    </div>

    {/* Trading details. Someone selling services under a domain name should
        say who is behind it, and under what. */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-t border-rule pt-8">
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-faint">
        {site.business.legalName} trading as {site.business.tradingName} · {site.business.structure}
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-widest">
        <li><a href="/services/" class="link text-ink-dim">Services</a></li>
        <li><a href="/start/" class="link text-ink-dim">Start a project</a></li>
        <li><a href="/privacy/" class="link text-ink-dim">Privacy</a></li>
      </ul>
    </div>
  </div>

  {/* ── 3. The wordmark ──────────────────────────────────────────────── */}
  <div class="wordmark-band mx-auto max-w-6xl px-6 lg:px-10 mt-6" aria-hidden="true">
    <div class="wordmark">
      <span class="ink">Dylan Collins</span>
      {/* The same word in the accent, shown only through a soft circle that
          follows the pointer and grows as it comes near. */}
      <span class="glow">Dylan Collins</span>
    </div>
  </div>
</footer>

<style>
  .wordmark-band {
    container-type: inline-size;
  }
  .wordmark {
    position: relative;
    /* The name is about 5.9em wide at this weight and tracking, so this
       makes it span the measure, whatever the measure is. */
    font-size: 16.8cqw;
    line-height: 1;
    /* Show the top three fifths of the line box: caps in, baseline and
       descenders under the edge of the page. */
    height: 0.6em;
    overflow: hidden;
  }
  .wordmark span {
    display: block;
    font-weight: 700;
    letter-spacing: -0.035em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-rule-strong);
    user-select: none;
  }
  /* The pointer's light. --glow is 0 far away and 1 on the band; --mx and
     --my are the pointer's place in the band. The circle grows as the
     pointer comes closer, so the first sign is a small patch at the edge
     nearest the cursor and on the letters it is a broad pool. */
  .wordmark .glow {
    position: absolute;
    inset: 0;
    -webkit-text-stroke-color: var(--color-accent);
    opacity: var(--glow, 0);
    -webkit-mask-image: radial-gradient(
      circle calc(8cqw + 14cqw * var(--glow, 0)) at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      rgb(0 0 0 / 0.55) 45%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle calc(8cqw + 14cqw * var(--glow, 0)) at var(--mx, 50%) var(--my, 50%),
      #000 0%,
      rgb(0 0 0 / 0.55) 45%,
      transparent 100%
    );
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .wordmark span {
      -webkit-text-stroke-width: 1px;
    }
  }
</style>

<script>
  /* Drives the wordmark's light from the pointer. Distance from the pointer
     to the band's box sets the strength, zero beyond a reach of about 360px
     and one on the band; the pointer's position within the band places the
     circle. Pointer devices only, and nothing runs until the first move. */
  const band = document.querySelector<HTMLElement>(".wordmark-band");
  if (band && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const REACH = 360;
    let px = -1e4, py = -1e4, raf = 0;
    const update = () => {
      raf = 0;
      const r = band.getBoundingClientRect();
      const dx = Math.max(r.left - px, 0, px - r.right);
      const dy = Math.max(r.top - py, 0, py - r.bottom);
      const glow = Math.max(0, 1 - Math.hypot(dx, dy) / REACH);
      band.style.setProperty("--glow", glow.toFixed(3));
      /* The circle sits on the nearest point of the band, not on the pointer
         itself, so coming in from above lights the letters under the cursor
         rather than the empty space beside them. */
      const mx = Math.min(Math.max(px - r.left, 0), r.width);
      const my = Math.min(Math.max(py - r.top, 0), r.height);
      band.style.setProperty("--mx", `${mx}px`);
      band.style.setProperty("--my", `${my}px`);
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener("pointermove", (e) => { px = e.clientX; py = e.clientY; queue(); }, { passive: true });
    window.addEventListener("scroll", queue, { passive: true });
    document.addEventListener("pointerleave", () => { px = -1e4; py = -1e4; queue(); });
  }
</script>
