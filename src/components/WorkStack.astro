---
/**
 * A short stack of screenshots that fans out when the card it sits in is
 * hovered.
 *
 * At rest the three sit squared up, each one a step up and back, so the
 * stack reads as a pile. On hover the top one swings right and the bottom
 * one swings left, a few degrees each, and the middle stays put: enough to
 * show there are more, not enough to lose the shape. The whole thing eases
 * on the site's one curve and settles back on leave.
 *
 * Images are 16:10 captures and the box is 16:10, so nothing is cropped.
 * Left at its rest state under reduced motion.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  /** Describes the first screenshot; the ones behind it are decorative. */
  alt: string;
  /** On the accent-filled card the edges go white rather than grey. */
  onAccent?: boolean;
  class?: string;
}
const { images, alt, onAccent = false, class: className = "" } = Astro.props;
const shots = images.slice(0, 3);
---

<div class:list={["stack", onAccent && "on-accent", className]}>
  {shots.map((img, i) => (
    <div class="slot">
      <Image
        src={img}
        alt={i === 0 ? alt : ""}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 440px, 90vw"
        class="shot"
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>

<style>
  .stack {
    position: relative;
    aspect-ratio: 16 / 10;
    /* Room either side for the fan, so it never leaves the card. */
    width: 86%;
    margin: 4% auto;
  }
  /* Two layers per screenshot, so the entry and the hover never share a
     transition: the slot rises in once, on its own delay; the shot inside
     holds the pile and fans with no delay at all. */
  .slot {
    position: absolute;
    inset: 0;
    transition:
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .slot:nth-child(1) { z-index: 3; }
  .slot:nth-child(2) { z-index: 2; }
  .slot:nth-child(3) { z-index: 1; }
  .shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border-radius: 10px;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper-2);
    transform-origin: 50% 100%;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .on-accent .shot {
    border-color: rgb(255 255 255 / 0.45);
  }

  /* Rest: a pile, top one in front. */
  .slot:nth-child(2) .shot { transform: translate(4%, -5%) scale(0.96); }
  .slot:nth-child(3) .shot { transform: translate(8%, -10%) scale(0.92); }

  /* Hover: fan. Triggered by the card, which carries .group. */
  :global(.group:hover) .slot:nth-child(1) .shot { transform: translate(9%, 3%) rotate(4deg); }
  :global(.group:hover) .slot:nth-child(2) .shot { transform: translate(0, -3%) rotate(-1deg) scale(0.97); }
  :global(.group:hover) .slot:nth-child(3) .shot { transform: translate(-9%, -6%) rotate(-6deg) scale(0.94); }

  /* Entry: before the card is revealed the three sit lower and faded, each a
     little more than the last, and rise into place one after another once
     it is, each pile following its own card's delay. */
  :global(html.js [data-reveal]:not(.is-visible)) .slot { opacity: 0; }
  :global(html.js [data-reveal]:not(.is-visible)) .slot:nth-child(1) { transform: translateY(12%); }
  :global(html.js [data-reveal]:not(.is-visible)) .slot:nth-child(2) { transform: translateY(15%); }
  :global(html.js [data-reveal]:not(.is-visible)) .slot:nth-child(3) { transform: translateY(18%); }
  :global(html.js [data-reveal].is-visible) .slot:nth-child(1) { transition-delay: calc(var(--reveal-delay, 0s) + 0.3s); }
  :global(html.js [data-reveal].is-visible) .slot:nth-child(2) { transition-delay: calc(var(--reveal-delay, 0s) + 0.42s); }
  :global(html.js [data-reveal].is-visible) .slot:nth-child(3) { transition-delay: calc(var(--reveal-delay, 0s) + 0.54s); }

  @media (prefers-reduced-motion: reduce) {
    .slot,
    .shot { transition: none; }
    :global(html.js [data-reveal]:not(.is-visible)) .slot { opacity: 1; transform: none; }
    :global(.group:hover) .slot:nth-child(1) .shot { transform: none; }
    :global(.group:hover) .slot:nth-child(2) .shot { transform: translate(4%, -5%) scale(0.96); }
    :global(.group:hover) .slot:nth-child(3) .shot { transform: translate(8%, -10%) scale(0.92); }
  }
</style>
