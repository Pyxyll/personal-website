---
/**
 * The small mark beside a /now item's label (lib/now.ts), in the site's
 * monoline: 16px, 1.5px strokes. Learning Japanese gets a kana rather than a
 * drawing, and the building line, which is live streaming, gets a live
 * light that blinks like an on-air sign. Decorative: the label says it.
 */
import type { NowItem } from "../lib/now";

interface Props {
  kind: NowItem["kind"];
}
const { kind } = Astro.props;

const marks: Record<string, string> = {
  work: "M2.75 5.25h10.5a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1H2.75a1 1 0 0 1-1-1v-6.5a1 1 0 0 1 1-1zM5.75 5.25v-1.5a1 1 0 0 1 1-1h2.5a1 1 0 0 1 1 1v1.5M1.75 8.75h12.5",
  building: "M5.17 10.83a4 4 0 0 1 0-5.66M10.83 5.17a4 4 0 0 1 0 5.66M3.05 12.95a7 7 0 0 1 0-9.9M12.95 3.05a7 7 0 0 1 0 9.9",
  reading: "M8 4.25c-1.5-1-3.5-1.25-5.75-1v9.5c2.25-.25 4.25 0 5.75 1 1.5-1 3.5-1.25 5.75-1v-9.5c-2.25-.25-4.25 0-5.75 1zM8 4.25v9.5",
  playing: "M5 5.25h6a3.25 3.25 0 0 1 3.15 4.05l-.5 2a1.5 1.5 0 0 1-2.6.6L9.6 10.25H6.4l-1.45 1.65a1.5 1.5 0 0 1-2.6-.6l-.5-2A3.25 3.25 0 0 1 5 5.25zM5.25 7.25v2M4.25 8.25h2M10.75 7.75h.01M12 9h.01",
  thinking: "M6 12.75h4M6.5 14.5h3M8 2.25a4 4 0 0 0-2.5 7.1c.45.4.75.95.75 1.55v.35h3.5v-.35c0-.6.3-1.15.75-1.55A4 4 0 0 0 8 2.25z",
  off: "M3 6.25h8.25v3.5a3.5 3.5 0 0 1-3.5 3.5h-1.25A3.5 3.5 0 0 1 3 9.75zM11.25 7.25h.75a1.75 1.75 0 0 1 0 3.5h-.75M5.5 2.5v1.5M8 2v2",
};
---

{kind === "learning" ? (
  <span class="now-kana" aria-hidden="true">あ</span>
) : (
  <svg
    class="now-mark"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={marks[kind]} />
    {kind === "building" && <circle class="now-live" cx="8" cy="8" r="1.6" fill="var(--color-accent)" stroke="none" />}
  </svg>
)}

<style>
  .now-mark {
    flex-shrink: 0;
    color: var(--color-ink-dim);
  }
  .now-kana {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    color: var(--color-ink-dim);
  }
  /* On, then off, as a broadcast light does. */
  .now-live {
    animation: now-live 2.4s ease-in-out infinite;
  }
  @keyframes now-live {
    0%,
    60%,
    100% {
      opacity: 1;
    }
    80% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-live {
      animation: none;
    }
  }
</style>
