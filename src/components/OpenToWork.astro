---
/**
 * The "open to new roles" line: a pink dot and a short mono sentence.
 *
 * Renders nothing unless site.hiring.open is true, so every place that might
 * say it is switched from one flag in lib/site.ts. Drop it in wherever the
 * line belongs and forget about it.
 */
import { site } from "../lib/site";

interface Props {
  /** Add what kind of role, after the line. */
  detail?: boolean;
  class?: string;
}
const { detail = false, class: className = "" } = Astro.props;
---

{site.hiring.open && (
  <p class:list={["font-mono text-xs uppercase tracking-widest text-ink-dim m-0", className]}>
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent mr-2 align-middle" aria-hidden="true"></span>
    {site.hiring.line}{detail && <span class="text-ink-faint"> · {site.hiring.looking}</span>}
  </p>
)}
