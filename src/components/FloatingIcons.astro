---
/**
 * Scattered tiles that drift, each cycling through a few icons — and that fall
 * into formation when the panel's CTA is hovered.
 *
 * Placed absolutely across the panel rather than stacked in a column. A column
 * with horizontal offsets still reads as a column: the eye picks up the even
 * vertical rhythm long before it picks up the nudges. Real scatter needs both
 * axes free, so each tile carries its own coordinates.
 *
 * Purely decorative — it sits behind the copy and says nothing the copy
 * doesn't — so the layer is hidden from the accessibility tree and takes no
 * pointer events.
 *
 * Icons are lucide SVGs inlined at build time via `?raw`, so nothing about
 * this ships JavaScript: the drift, the cross-fade and the formation are all
 * CSS, and the formation moves only by transform. Swapping an icon is a line
 * in TILES.
 */
import CornerNodes from "./CornerNodes.astro";
import globe from "lucide-static/icons/globe.svg?raw";
import layout from "lucide-static/icons/layout-dashboard.svg?raw";
import plug from "lucide-static/icons/plug.svg?raw";
import server from "lucide-static/icons/server.svg?raw";
import code from "lucide-static/icons/code.svg?raw";
import zap from "lucide-static/icons/zap.svg?raw";
import gauge from "lucide-static/icons/gauge.svg?raw";
import database from "lucide-static/icons/database.svg?raw";
import workflow from "lucide-static/icons/workflow.svg?raw";

/**
 * Two positions per tile:
 *
 *   x / y    scattered, as percentages of the panel, so the scatter spreads
 *            with it: clustered in the group's upper corner, fanning down and
 *            inward, above the headline and out to the side of it.
 *   dx / dy  in formation, in rem from the cluster's centre (CENTRE below),
 *            so the formation is the same shape and the same gaps at every
 *            panel size and the tiles never land on each other. A tile is
 *            4rem with 0.75rem between: -4.375 / 0.375 put a tile's edge half
 *            a gap either side of the centre line, -2 centres it on it.
 *
 * Left is a pyramid, an apex over two; right is the same turned over, two
 * over one, so the pair mirror each other across the headline. Each tile
 * goes to the place nearest where it floats, so no two paths cross.
 *
 * `slot` (how long each icon holds) differs per tile on purpose. A shared
 * rate makes six tiles blink in unison, which reads as one mechanism rather
 * than six loose objects.
 */
const TILES = {
  left: [
    { icons: [globe, code, workflow], x: 15, y: 9, dx: -2, dy: -4.375, rotate: -13, delay: 0, drift: 7.4, slot: 8.6, in: 0.16, dur: 0.6 },
    { icons: [layout, gauge, database], x: 8, y: 27, dx: -4.375, dy: 0.375, rotate: 9, delay: 0.9, drift: 8.8, slot: 10.4, in: 0, dur: 0.52 },
    { icons: [plug, zap, server], x: 23, y: 36, dx: 0.375, dy: 0.375, rotate: -7, delay: 1.7, drift: 6.6, slot: 7.9, in: 0.06, dur: 0.56 },
  ],
  right: [
    { icons: [server, database, globe], x: 81, y: 12, dx: 0.375, dy: -4.375, rotate: 12, delay: 0.5, drift: 8.2, slot: 11.3, in: 0.21, dur: 0.63 },
    { icons: [zap, workflow, plug], x: 73, y: 30, dx: -4.375, dy: -4.375, rotate: -8, delay: 1.4, drift: 7, slot: 9.2, in: 0.03, dur: 0.54 },
    { icons: [gauge, code, layout], x: 87, y: 40, dx: -2, dy: 0.375, rotate: 15, delay: 2.1, drift: 9.2, slot: 9.8, in: 0.1, dur: 0.58 },
  ],
} as const;

/** Where each formation, and the box drawn round it, is centred: as
    percentages of the panel, out to the side of the headline. */
const CENTRE = { left: { x: 18, y: 35 }, right: { x: 82, y: 35 } } as const;

interface Props {
  side: "left" | "right";
  class?: string;
}
const { side, class: className = "" } = Astro.props;
const tiles = TILES[side];
---

<div class:list={["ftiles", className]} style={`--cx:${CENTRE[side].x};--cy:${CENTRE[side].y}`} aria-hidden="true">
  <span class="fbox">
    <CornerNodes size={10} radius={0} color="var(--color-rule-strong)" />
  </span>

  {tiles.map((tile) => (
    <span
      class="ftile"
      style={`--x:${tile.x};--y:${tile.y};--dx:${tile.dx}rem;--dy:${tile.dy}rem;--r:${tile.rotate}deg;--d:${tile.delay}s;--t:${tile.drift}s;--in:${tile.in}s;--dur:${tile.dur}s`}
    >
      <span class="fface">
        {tile.icons.map((svg, i) => (
          <span
            class="fico"
            style={`--cycle:${tile.icons.length * tile.slot}s;--slot:${i * tile.slot}s`}
            set:html={svg}
          />
        ))}
      </span>
    </span>
  ))}
</div>

<style>
  /* How it moves, and why like this.
     The tile (outer) carries the trip and the straightening as `translate`
     and `rotate`; the face (inner) carries the float. Each is one property on
     one element, so nothing contends.
     The float is a number, --bob, animated from 0 to 1 and back, times an
     amplitude, --lift. Both are registered, so the browser interpolates both
     every frame and the face's offset is always their product, worked out
     fresh. A keyframe that reads a changing var() is only re-read when the
     browser gets round to it, which is how a float used to stop with a jump.
     On the way into formation the amplitude shrinks to nothing over the same
     time and easing as the trip, so the float dissolves into the move rather
     than dropping away ahead of it; the float is slow enough (seven seconds
     or so a cycle) that it barely moves during the trip. On the way out it
     all runs backwards, after a short wait, so passing between the two
     buttons, or brushing off one for a moment, does not set it off. */
  @property --lift {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }
  @property --bob {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  /* A size container, so a tile can measure the trip to the formation in
     the panel's own units (cqw, cqh) and make it as a transform. */
  .ftiles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    container-type: size;
  }

  /* Outer: where the tile floats, and which way up it is. It sits at its
     scattered place and never leaves it as far as layout is concerned: the
     trip to the formation is `translate`, and the straightening `rotate`,
     both of which the compositor runs on its own, so the move stays smooth
     whatever else the page is doing. Animating `left` and `top`, as this used
     to, sent every frame back through layout. Travel and delay come from the
     tile, so no two arrive together. */
  .ftile {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: 4rem;
    height: 4rem;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --rest: 0.15s;
    translate: 0 0;
    rotate: var(--r);
    transition:
      translate var(--dur) var(--ease) calc(var(--rest) + var(--in)),
      rotate var(--dur) var(--ease) calc(var(--rest) + var(--in));
    will-change: translate, rotate;
  }

  /* Inner: the face, and the drift. Only ever translates. */
  .fface {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    --lift: -12px;
    border: 2px dashed var(--color-rule-strong);
    border-radius: 10px;
    /* Near solid rather than blurred glass. The shader behind never stops
       moving, so a backdrop blur on six tiles is six blurs redone every frame,
       and more while they travel; the jank was mostly that. */
    background: color-mix(in srgb, var(--color-paper-2) 88%, transparent);
    animation: ftile-drift var(--t) ease-in-out var(--d) infinite;
    translate: 0 calc(var(--bob) * var(--lift));
    transition: --lift var(--dur) var(--ease) calc(var(--rest) + var(--in));
    will-change: translate;
  }

  @keyframes ftile-drift {
    0%,
    100% {
      --bob: 0;
    }
    50% {
      --bob: 1;
    }
  }

  /* The formation.
     Triggered from the panel rather than from the tiles: :has() lets an
     ancestor react to the buttons being hovered, which is the only way a
     sibling subtree can respond to them in CSS. The trigger is the row the
     two buttons sit in (.fctas), gap included, so moving from one to the
     other never leaves it. */
  :global(.fpanel:has(.fctas:hover)) .ftile {
    translate:
      calc((var(--cx) - var(--x)) * 1cqw + var(--dx))
      calc((var(--cy) - var(--y)) * 1cqh + var(--dy));
    rotate: 0deg;
    transition:
      translate var(--dur) var(--ease) var(--in),
      rotate var(--dur) var(--ease) var(--in);
  }
  /* The float winds down with the trip rather than being cancelled, which
     would snap the face back from wherever in the rise it happened to be. */
  :global(.fpanel:has(.fctas:hover)) .fface {
    --lift: 0px;
    transition: --lift var(--dur) var(--ease) var(--in);
  }

  /* The box round a formation: centred on it, and sized in rem like the
     formation, 8.75rem of tiles with 1.125rem clear all round. It does not
     travel, so it can keep its blur; it scales in by `scale`, leaving
     `translate` to centre it. */
  .fbox {
    position: absolute;
    left: calc(var(--cx) * 1%);
    top: calc(var(--cy) * 1%);
    width: 11rem;
    height: 11rem;
    translate: -50% -50%;
    border: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-paper-2) 60%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    scale: 0.94;
    transition:
      opacity 0.4s ease 0.15s,
      scale 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }
  :global(.fpanel:has(.fctas:hover)) .fbox {
    opacity: 1;
    scale: 1;
    transition-delay: 0.34s; /* the first tiles have set, the last is still coming */
  }

  /* Joints arrive after the frame, unevenly. `scale` rather than `transform`:
     the nodes already use transform to centre themselves on the corner, and
     the two would overwrite each other. */
  .fbox :global(.corner-nodes > span) {
    opacity: 0;
    scale: 0.35;
    transition:
      opacity 0.22s ease 0.15s,
      scale 0.34s cubic-bezier(0.2, 0.9, 0.3, 1) 0.15s;
  }
  :global(.fpanel:has(.fctas:hover)) .fbox :global(.corner-nodes > span) {
    opacity: 1;
    scale: 1;
  }
  :global(.fpanel:has(.fctas:hover)) .fbox :global(.corner-nodes > span:nth-child(1)) { transition-delay: 0.56s; }
  :global(.fpanel:has(.fctas:hover)) .fbox :global(.corner-nodes > span:nth-child(2)) { transition-delay: 0.68s; }
  :global(.fpanel:has(.fctas:hover)) .fbox :global(.corner-nodes > span:nth-child(3)) { transition-delay: 0.62s; }
  :global(.fpanel:has(.fctas:hover)) .fbox :global(.corner-nodes > span:nth-child(4)) { transition-delay: 0.74s; }

  .fico {
    position: absolute;
    display: grid;
    place-items: center;
    opacity: 0;
    animation: fico-cycle var(--cycle) ease-in-out var(--slot) infinite;
  }

  /* Percentages, so the shape holds whatever rate a tile runs at.
     Three icons means each owns 33.3% of the cycle, and the visible window now
     fills it: the outgoing icon is still going as the next arrives. The long
     changeover was never the fade itself — it was the dead air after it, which
     left the tile empty for a beat before anything replaced it.
     On a ~26s cycle: ~0.4s up, ~8s held, ~0.4s away, no gap. */
  @keyframes fico-cycle {
    0% {
      opacity: 0;
    }
    1.5% {
      opacity: 1;
    }
    32% {
      opacity: 1;
    }
    33.5%,
    100% {
      opacity: 0;
    }
  }

  .fico :global(svg) {
    width: 24px;
    height: 24px;
    stroke: var(--color-ink-dim);
    stroke-width: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .fface,
    .fico {
      animation: none;
    }
    /* The formation is a state change worth keeping; it just arrives at once
       rather than travelling there. */
    .ftile,
    .fface,
    .fbox,
    .fbox :global(.corner-nodes > span) {
      transition: none;
    }
    .fbox :global(.corner-nodes > span) {
      scale: 1;
      opacity: 1;
    }
    /* Without the cycle every icon in a tile would stack on top of the others. */
    .fico {
      opacity: 0;
    }
    .fico:first-child {
      opacity: 1;
    }
  }
</style>
