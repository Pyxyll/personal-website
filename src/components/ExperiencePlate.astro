---
/**
 * The CV on the homepage: every role drawn against the same run of years.
 *
 * A list of jobs says what and when. A chart of them also says how long, what
 * overlapped, and what is current, at a glance, which is most of what someone
 * skimming a CV is trying to work out. So each row is a role on the left and
 * its span on the right, on one shared scale, with the scale itself as the
 * plate's last row.
 *
 * Drawn the way the marks are drawn: 1.5px outlines, hairline guides, mono
 * for the figures, and one pink thing, which is the role that is still going.
 *
 * The chart shows from md up. Below that there is no width for a scale to
 * mean anything, and the rows stand on their dates, which they carry in text
 * at every size anyway: the bars are decoration over information that is
 * already there, and are hidden from the accessibility tree.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import ArrowIcon from "./ArrowIcon.astro";
import { cv } from "../lib/cv";

const hasPdf = existsSync(join(process.cwd(), "public", cv.pdf));

const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
const today = new Date();

/** "Jul 2024" or "2022" as a decimal year at the start of that month.
    "Present" is the day the site was built. Null if it reads as neither. */
function at(text: string): { year: number; month: boolean } | null {
  const t = text.trim();
  if (/^present$/i.test(t)) return { year: today.getFullYear() + today.getMonth() / 12, month: true };
  const m = /^(?:([A-Za-z]{3})[A-Za-z]*\.?\s+)?(\d{4})$/.exec(t);
  if (!m) return null;
  const month = m[1] ? MONTHS.indexOf(m[1].toLowerCase()) : -1;
  return { year: Number(m[2]) + Math.max(0, month) / 12, month: month >= 0 };
}

const roles = cv.experience.map((role) => {
  const start = at(role.start);
  const end = at(role.end);
  /* An end date includes the month it names: "to Oct 2023" runs to the end
     of October. A bare year runs to the end of that year. */
  const from = start?.year ?? null;
  const to = end ? end.year + (end.month ? 1 / 12 : 1) : null;
  return { ...role, from, to, current: /^present$/i.test(role.end.trim()) };
});

const dated = roles.filter((r) => r.from !== null && r.to !== null);
const first = Math.floor(Math.min(...dated.map((r) => r.from!)));
const lastYear = Math.ceil(Math.max(...dated.map((r) => r.to!)));
const span = Math.max(1, lastYear - first);
const pct = (year: number) => ((year - first) / span) * 100;

/* A label every few years, however long the run is. */
const every = span >= 12 ? 4 : span >= 6 ? 2 : 1;
const years = Array.from({ length: span + 1 }, (_, i) => first + i);
const labelled = (y: number) => (y - first) % every === 0;

const period = (start: string, end: string) => `${start} to ${end === "Present" ? "present" : end}`;
---

<div class="xp rounded-[6px] border border-rule" style={`--every:${(every / span) * 100}%`}>
  {roles.map((role, i) => (
    <div class:list={["row grid grid-cols-1 md:grid-cols-12 md:gap-x-8 px-6 sm:px-8", i > 0 && "border-t border-rule"]}>
      <div class="md:col-span-6 lg:col-span-5 flex flex-col gap-1.5 py-5">
        <h3 class="text-lg font-semibold tracking-tight leading-snug m-0">
          {role.title}
          <span class="font-normal text-ink-dim"> · {role.org}</span>
        </h3>
        <span class="font-mono text-[13px] leading-none text-ink-faint">{period(role.start, role.end)}</span>
      </div>

      <div class="track hidden md:block md:col-span-6 lg:col-span-7" aria-hidden="true">
        {role.from !== null && role.to !== null && (
          <span
            class:list={["bar", role.current && "is-current"]}
            style={`left:${pct(role.from)}%;width:${pct(role.to) - pct(role.from)}%;--i:${i}`}
          ></span>
        )}
      </div>
    </div>
  ))}

  {/* The scale, and the way to the whole thing. */}
  <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-8 px-6 sm:px-8 border-t border-rule">
    <div class="md:col-span-6 lg:col-span-5 flex flex-wrap items-center gap-x-6 gap-y-2 py-5">
      <a
        href="/cv/"
        class="inline-flex items-center gap-1.5 text-[13px] font-medium text-accent-text transition-colors duration-300 hover:text-ink"
      >
        Full CV
        <ArrowIcon />
      </a>
      {hasPdf && (
        <a
          href={cv.pdf}
          download
          class="text-[13px] font-medium text-ink-dim transition-colors duration-300 hover:text-ink"
        >
          Download as PDF
        </a>
      )}
    </div>

    <div class="scale hidden md:block md:col-span-6 lg:col-span-7" aria-hidden="true">
      {years.map((y) => (
        <span class:list={["tick", labelled(y) && "is-major"]} style={`left:${pct(y)}%`}>
          {labelled(y) && <span class="year">{y}</span>}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  /* The span column. It fills its row top to bottom, so the guides drawn on
     it join up from one row to the next and run the height of the plate. */
  .track,
  .scale {
    position: relative;
    background-image: linear-gradient(to right, var(--color-rule) 1px, transparent 1px);
    background-size: var(--every) 100%;
  }

  /* An outlined bar, the same 1.5px line and the same proportions as the
     bars in the audit mark. */
  .bar {
    position: absolute;
    top: 50%;
    height: 10px;
    min-width: 7px;
    margin-top: -5px;
    border: 1.5px solid var(--color-ink-dim);
    transform-origin: 0 50%;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(0.3s + var(--i, 0) * 0.09s);
  }
  .bar.is-current {
    border-color: var(--color-accent);
  }

  /* Ticks hang from the top edge of the scale row: one per year, longer and
     named on the labelled ones, which are the years the guides stand on. */
  .scale {
    height: 3.25rem;
    background-image: none;
  }
  .tick {
    position: absolute;
    top: 0;
    width: 1px;
    height: 5px;
    background: var(--color-rule-strong);
  }
  .tick.is-major {
    height: 9px;
  }
  .year {
    position: absolute;
    top: 16px;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1;
    color: var(--color-ink-faint);
  }
  /* The first label would hang off the plate's left edge if it were centred
     on its tick like the rest. */
  .tick:first-child .year {
    transform: none;
  }

  /* Entry: each bar is measured out from its start date, one after another,
     once the section has arrived. */
  :global(html.js [data-reveal]:not(.is-visible)) .bar {
    transform: scaleX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
    :global(html.js [data-reveal]:not(.is-visible)) .bar {
      transform: none;
    }
  }
</style>
