---
/**
 * One schematic per service: a technical line drawing that assembles itself,
 * then does its job on a loop.
 *
 * ── The language ─────────────────────────────────────────────────────────
 * Drawn the way a network diagram is drawn, not the way an icon is:
 *
 *   - A 1.5px monoline that is 1.5px at every size. Stroke widths are in
 *     user units, so marks.ts measures each figure and sets --sw to whatever
 *     user-unit width renders as 1.5px. Labels are sized off the same number
 *     and so hold at about 13px too. Without the script they fall back to
 *     the value below, which is right for the services page.
 *   - A dot grid as the ground. Lines land on it where they can.
 *   - Depth from structure, never from light: a plate behind a plate, an
 *     isometric slab, a dashed ring around a solid one. No shadow, no glow.
 *   - Anything that flows is dashed, and the dashes march.
 *   - Small mono labels are part of the drawing. They are what turns an icon
 *     into an infographic, and they show where there is room for them: on
 *     the services page, with the caption.
 *   - The accent is a signal, not a paint. One pink thing per mark, and it is
 *     the thing that moves or the thing that matters.
 *
 * ── Two acts ─────────────────────────────────────────────────────────────
 *   entry   the drawing draws itself: strokes in document order, then the
 *           flows, labels and dots fade in. About 1.5s, once.
 *   loop    the service's verb as a flow: a dot travelling a line, a node
 *           changing state, a value being measured. Then a rest.
 *
 * All of it lives in scripts/marks.ts. This file only draws the finished
 * schematic and tags the parts the script moves (data-el). Without JavaScript
 * the finished drawing is simply there, and under reduced motion the script
 * stays out and the same finished drawing is what you get.
 *
 * Classes the script relies on:
 *   .m-ink .m-rule .m-sig   stroked parts, drawn on during the entry
 *   .f-ink .f-sig           filled parts, faded in
 *   .flow                   dashed and marching, faded in
 *   .lead                   a flow that only points at a label; hidden with it
 *   .lbl                    labels, faded in last
 *   .fx                     loop-only parts, hidden at rest
 *
 * aria-hidden: the caption carries the meaning where it shows, and where it
 * doesn't the pitch beside the drawing already does.
 */
import { services } from "../lib/services";

interface Props {
  slug: string;
  /** Show the figure caption. Turns the in-drawing labels on unless overridden. */
  caption?: boolean;
  /** Show the mono labels inside the drawing. Defaults to follow caption. */
  labels?: boolean;
  /** Draw for a light plate: dark ink, light ground. The pink stays pink. */
  inverted?: boolean;
  /** Run the entry and the loop. Off gives the finished drawing, still. */
  animate?: boolean;
  class?: string;
}
const {
  slug,
  caption = false,
  labels = caption,
  inverted = false,
  animate = true,
  class: className = "",
} = Astro.props;

const num = services.find((s) => s.slug === slug)?.num ?? "";

const captions: Record<string, string> = {
  website: "One page, one thing worth clicking.",
  app: "The spreadsheet, given a shape.",
  automation: "It runs itself, on its own clock.",
  hosting: "Stacked, watched, answered at 03:14.",
  ai: "Forty layouts in, one shape out.",
  audit: "What it costs you now, in order.",
};

const grid = `dots-${slug}`;
---

<figure
  class:list={[
    "sketch",
    `is-${slug}`,
    animate && "is-live",
    labels && "has-labels",
    inverted && "is-inverted",
    className,
  ]}
  data-mark={animate ? slug : undefined}
>
  {/* The sheet is a window: the hover camera pushes the drawing to twice its
      size and this box crops it, so it never spills over the copy or the
      caption. */}
  <div class="sheet">
  <svg viewBox="0 0 200 120" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <pattern id={grid} width="10" height="10" patternUnits="userSpaceOnUse">
        <circle cx="5" cy="5" r="0.7" class="dot" />
      </pattern>
    </defs>
    {/* Oversized: the grid drifts under the hover parallax and must not show an edge. */}
    <rect class="grid" x="-10" y="-10" width="220" height="140" fill={`url(#${grid})`} />

    {slug === "website" && (
      <>
        {/* A page: a plate behind a plate, a header, three lines of copy and
            the one button. The cursor is the pink thing, and at rest it sits
            on the button. */}
        <rect class="m-rule" x="56" y="26" width="100" height="76" rx="2" />
        <rect class="m-ink" data-el="frame" x="50" y="20" width="100" height="76" rx="2" />
        <path class="m-ink" d="M50 32H150" />
        <circle class="f-ink" cx="56" cy="26" r="1.3" />
        <circle class="f-ink" cx="61" cy="26" r="1.3" />
        <path class="m-rule" d="M62 46H118" />
        <path class="m-rule" d="M62 54H106" />
        <path class="m-rule" d="M62 62H112" />
        <rect class="m-ink" data-el="cta" x="62" y="72" width="36" height="12" rx="1.5" />
        <path class="flow lead" d="M98 78H170V96" />
        <text class="lbl" x="50" y="14">index.html</text>
        <text class="lbl" x="170" y="108" text-anchor="end">one action</text>
        <circle class="f-sig" data-el="cursor" cx="80" cy="78" r="2" />
      </>
    )}

    {slug === "app" && (
      <>
        {/* A sheet on the left, piped into a dashboard on the right. The
            dashboard's live reading is the pink thing. */}
        <rect class="m-rule" x="24" y="36" width="50" height="48" />
        <path class="m-rule" d="M24 48H74M24 60H74M24 72H74M34 36V84M44 36V84M54 36V84M64 36V84" />
        <rect class="m-rule" x="114" y="36" width="66" height="54" rx="2" />
        <rect class="m-ink" data-el="panel" x="108" y="30" width="66" height="54" rx="2" />
        <path class="m-ink" d="M108 44H174M141 44V84" />
        <path class="m-ink" data-el="bar" d="M116 76V62" />
        <path class="m-ink" data-el="bar" d="M122 76V56" />
        <path class="m-ink" data-el="bar" d="M128 76V66" />
        <path class="m-ink" data-el="bar" d="M134 76V52" />
        <path class="m-ink" data-el="spark" d="M146 72L152 66L158 69L164 58L170 62" />
        <path class="flow" d="M74 60H108" />
        <text class="lbl" x="24" y="30">rows 1,240</text>
        <text class="lbl" x="174" y="98" text-anchor="end">live</text>
        <circle class="f-sig" data-el="tip" cx="170" cy="62" r="1.8" />
      </>
    )}

    {slug === "automation" && (
      <>
        {/* A ring with a gap and a chevron, two stations on it, something in
            and something out. The job going round is the pink thing. */}
        <path class="m-ink" data-el="ring" d="M129.7 89.7A42 42 0 1 1 129.7 30.3" />
        <path class="m-ink" d="M118 27.5L129.7 30.3L127 19" />
        <circle class="m-ink node" data-el="node" cx="58" cy="60" r="3" />
        <circle class="m-ink node" data-el="node" cx="100" cy="18" r="3" />
        <path class="flow" d="M14 60H54" />
        <path class="flow" d="M100 14V4" />
        <text class="lbl" x="14" y="55">in</text>
        <text class="lbl" x="104" y="8">out</text>
        <text class="lbl" x="100" y="114" text-anchor="middle">every 5 min</text>
        <circle class="f-sig" data-el="job" cx="129.7" cy="89.7" r="2.6" />
      </>
    )}

    {slug === "hosting" && (
      <>
        {/* Three isometric slabs, a light on each. The live light is the pink
            thing, and its check runs up the dashed leader to the log line. */}
        <path class="m-ink" d="M48 84L108 54L148 74L88 104Z" />
        <path class="m-ink" d="M48 84V92L88 112V104M148 74V82L88 112" />
        <path class="m-ink" d="M48 62L108 32L148 52L88 82Z" />
        <path class="m-ink" d="M48 62V70L88 90V82M148 52V60L88 90" />
        <path class="m-ink" d="M48 40L108 10L148 30L88 60Z" />
        <path class="m-ink" d="M48 40V48L88 68V60M148 30V38L88 68" />
        <circle class="m-rule node" data-el="light" cx="57" cy="92.5" r="2" />
        <circle class="m-rule node" data-el="light" cx="57" cy="70.5" r="2" />
        <path class="flow lead" d="M57 48.5H36V20" />
        <text class="lbl" x="28" y="14">03:14 <tspan class="lbl-strong">200 ok</tspan></text>
        <text class="lbl" x="152" y="108">x3</text>
        <circle class="f-sig" data-el="live" cx="57" cy="48.5" r="2" />
      </>
    )}

    {slug === "ai" && (
      <>
        {/* Three documents of three shapes flow into a layered core, and one
            finished shape flows out. The core's centre is the pink thing; the
            travelling dots exist only for the loop. */}
        <rect class="m-rule" x="22" y="22" width="16" height="20" />
        <path class="m-rule" d="M26 28H34M26 32H32M26 36H34" />
        <rect class="m-rule" x="20" y="52" width="20" height="16" />
        <path class="m-rule" d="M24 58H36M24 62H32" />
        <rect class="m-rule" x="24" y="78" width="14" height="22" />
        <path class="m-rule" d="M27 84H35M27 88H33M27 92H35" />
        <circle class="m-rule dash" cx="100" cy="60" r="20" />
        <circle class="m-ink" data-el="core" cx="100" cy="60" r="12" />
        <rect class="m-ink" data-el="result" x="150" y="48" width="18" height="24" />
        <path class="m-ink" d="M154 55H164M154 60H164M154 65H160" />
        <path class="flow" data-el="in" d="M38 32H62L82.7 50" />
        <path class="flow" data-el="in" d="M40 60H80" />
        <path class="flow" data-el="in" d="M38 89H62L82.7 70" />
        <path class="flow" data-el="out" d="M120 60H150" />
        <text class="lbl" x="20" y="14">40 layouts</text>
        <text class="lbl" x="168" y="86" text-anchor="end">1 schema</text>
        <circle class="f-sig" data-el="centre" cx="100" cy="60" r="3" />
        <circle class="f-sig fx" data-el="doc" cx="0" cy="0" r="2" />
        <circle class="f-sig fx" data-el="doc" cx="0" cy="0" r="2" />
        <circle class="f-sig fx" data-el="doc" cx="0" cy="0" r="2" />
        <circle class="f-sig fx" data-el="packet" cx="0" cy="0" r="2" />
      </>
    )}

    {slug === "audit" && (
      <>
        {/* The findings ranked by hours lost, against a scale. The top one is
            the pink thing. The scan line that measures them is loop-only. */}
        <rect class="m-sig" data-el="bar" x="56" y="30" width="80" height="10" />
        <rect class="m-ink" data-el="bar" x="56" y="50" width="52" height="10" />
        <rect class="m-ink" data-el="bar" x="56" y="70" width="28" height="10" />
        <path class="m-rule" d="M56 96H156" />
        <path class="m-rule" d="M56 96v3M76 96v3M96 96v3M116 96v3M136 96v3M156 96v3" />
        <text class="lbl" x="56" y="16">hours lost / week</text>
        <text class="lbl" x="40" y="37.5">01</text>
        <text class="lbl" x="40" y="57.5">02</text>
        <text class="lbl" x="40" y="77.5">03</text>
        <text class="lbl lbl-strong" data-el="val" x="140" y="37.5">4.2h</text>
        <text class="lbl" data-el="val" x="112" y="57.5">1.5h</text>
        <text class="lbl" data-el="val" x="88" y="77.5">0.5h</text>
        <text class="lbl" x="56" y="108">0</text>
        <text class="lbl" x="156" y="108" text-anchor="end">5h</text>
        <path class="m-sig dash fx" data-el="scan" d="M56 24V88" />
      </>
    )}
  </svg>
  </div>

  {caption && (
    <figcaption class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint mt-4">
      Fig. {num} <span class="text-ink-dim ml-1">{captions[slug]}</span>
    </figcaption>
  )}
</figure>

<style>
  .sketch {
    margin: 0;
    /* User-unit stroke width that renders as 1.5px. The script sets this per
       figure from its rendered size; this fallback suits the services page. */
    --sw: 0.6;
    --cf: cubic-bezier(0.4, 0, 0.2, 1);
    /* The drawing's own palette, so one figure can sit on a light plate. The
       script reads --mk-ink and --mk-rule from here too, so the colours it
       tweens back to are always the figure's own. */
    --mk-ink: var(--color-ink-dim);
    --mk-rule: var(--color-rule-strong);
    --mk-faint: var(--color-ink-faint);
    --mk-strong: var(--color-ink-dim);
    --mk-node: var(--color-paper-2);
    --mk-dot: #262626;
    --mk-hover: var(--color-ink);
    --mk-hover-lbl: var(--color-ink-dim);
  }
  /* On a light plate: the brief's #262626 ink and its greys, mirrored. */
  .sketch.is-inverted {
    --mk-ink: #525252;
    --mk-rule: #a3a3a3;
    --mk-faint: #737373;
    --mk-strong: #525252;
    --mk-node: #fafafa;
    --mk-dot: #d4d4d4;
    --mk-hover: #262626;
    --mk-hover-lbl: #525252;
  }
  .sketch .sheet {
    position: relative;
    overflow: hidden;
    aspect-ratio: 5 / 3;
  }
  /* The 3D build (scripts/marks3d.ts) draws into a canvas that covers the
     whole card, behind its copy, with the object framed where this sheet
     sits at rest. Its labels are HTML pinned to the card, so they stay 13px
     at any distance. Once it is up the SVG is hidden; it remains the
     fallback. The canvas and label rules live in global.css because they
     are appended to the card, outside this component's scope. */
  .sketch.is-3d svg {
    visibility: hidden;
  }
  .sketch svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* The grid is drawn larger than the viewBox for the parallax; clip it back
     to the sheet so it does not spill into the card. */
  .sketch .grid {
    clip-path: inset(10px 10px 10px 10px);
  }

  /* ── Monoline ────────────────────────────────────────────────────────── */
  .sketch .m-ink,
  .sketch .m-rule,
  .sketch .m-sig {
    fill: none;
    stroke-width: var(--sw);
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.3s var(--cf);
  }
  .sketch .m-ink { stroke: var(--mk-ink); }
  .sketch .m-rule { stroke: var(--mk-rule); }
  .sketch .m-sig { stroke: var(--color-accent); }
  .sketch .node { fill: var(--mk-node); }
  .sketch .f-ink { fill: var(--mk-ink); }
  .sketch .f-sig { fill: var(--color-accent); }
  .sketch .dot { fill: var(--mk-dot); }

  /* Dashed lines: the dash is sized off the stroke so it reads the same at
     any size, and the flows march at a fixed pace. */
  .sketch .dash,
  .sketch .flow {
    stroke-dasharray: calc(var(--sw) * 2.5) calc(var(--sw) * 2.5);
  }
  .sketch .flow {
    fill: none;
    stroke: var(--mk-rule);
    stroke-width: calc(var(--sw) * 0.8);
    stroke-linecap: butt;
  }
  @keyframes march {
    to { stroke-dashoffset: calc(var(--sw) * -5); }
  }
  .sketch.is-live .flow {
    animation: march 1.1s linear infinite;
  }

  /* ── Labels ──────────────────────────────────────────────────────────── */
  .sketch .lbl {
    font-family: var(--font-mono);
    /* px in SVG is user units, and calc needs a unit to produce a length. */
    font-size: calc(var(--sw) * 8.5px);
    fill: var(--mk-faint);
    letter-spacing: 0.02em;
    transition: fill 0.3s var(--cf);
  }
  .sketch .lbl-strong { fill: var(--mk-strong); }
  .sketch:not(.has-labels) .lbl,
  /* Leaders exist to point at a label, so they go with it. */
  .sketch:not(.has-labels) .lead { display: none; }

  /* Loop-only parts. Hidden at rest so the finished drawing is the same with
     or without the script. */
  .sketch .fx { opacity: 0; }

  /* ── Hover: colour, never position ─────────────────────────────────── */
  .sketch:hover .m-ink,
  :global(.group:hover) .sketch .m-ink { stroke: var(--mk-hover); }
  .sketch:hover .lbl,
  :global(.group:hover) .sketch .lbl { fill: var(--mk-hover-lbl); }
  .sketch:hover .lbl-strong,
  :global(.group:hover) .sketch .lbl-strong { fill: var(--mk-hover); }

  /* Nothing shows until the script has put every part at its starting state,
     or the finished drawing flashes for a frame before it draws itself.
     Gated on .js so a blocked bundle leaves the drawing visible; the script
     adds .is-ready even under reduced motion, where it does nothing else. */
  :global(html.js) .sketch.is-live:not(.is-ready) svg {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sketch.is-live:not(.is-ready) svg {
      visibility: visible;
    }
    .sketch .flow {
      animation: none;
    }
  }
</style>

<script>
  import "../scripts/marks.ts";
</script>
