---
/**
 * One mark per service.
 *
 * These are marks, not diagrams: a single large shape built from a handful of
 * heavy primitives, closer to a logo than to an illustration of the work. The
 * old set drew literal little interfaces, which meant six figures competing on
 * detail at 200px wide and losing. Six silhouettes compete on shape instead —
 * frame, quadrants, ring, slabs, hub, lens — and stay legible at any size.
 *
 * ── The timeline ─────────────────────────────────────────────────────────
 * Every part runs the same cycle length and differs only in *when inside that
 * cycle* it appears. That is the whole trick, and it is why the lanes are
 * separate keyframe sets rather than one set plus animation-delay.
 *
 * A delay shifts an element's entire build → hold → teardown, so the last part
 * in was still holding while the first was already leaving, and the figure was
 * only fully assembled for about a second in six. Here the entry is staggered
 * and the exit is very nearly not, so the mark spends about three quarters of
 * the cycle standing complete:
 *
 *   lane 1   ▓▓▓░░░░░░░░░░░░░░░░░░░▓▓▓
 *   lane 3     ▓▓▓░░░░░░░░░░░░░░░░░░▓▓▓
 *   lane 5       ▓▓▓░░░░░░░░░░░░░░░░░▓▓▓
 *                └──── assembled ────┘
 *
 * Five lanes, .l1 to .l5. Parts that should arrive together share one.
 *
 * ── Rules that still apply ───────────────────────────────────────────────
 *   1. transform-box: fill-box on anything transformed, or transform-origin
 *      resolves against the viewBox and parts fly at the top-left corner.
 *   2. Every stroked element needs pathLength="1". The stroke classes set
 *      stroke-dasharray: 1, which with pathLength 1 is a single dash covering
 *      the whole path — solid at rest, and drawable by offsetting it. Miss the
 *      attribute and you get a 1-unit dotted line instead.
 *   3. Hover drives its own elements, invisible the rest of the time, so it
 *      never fights the loop for a property mid-cycle.
 *
 * Only transform, opacity and stroke-dashoffset are animated, so nothing here
 * touches layout. Loops are paused until the section is revealed, and reduced
 * motion stops everything at the finished mark.
 *
 * aria-hidden: where a caption shows it carries the meaning in text, and where
 * it doesn't the pitch beside the mark already does.
 */
import { services } from "../lib/services";

interface Props {
  slug: string;
  /** Show the figure caption. Off in tight spaces like the homepage plate. */
  caption?: boolean;
  /** Run the loop and the hover beat. */
  animate?: boolean;
  class?: string;
}
const { slug, caption = false, animate = true, class: className = "" } = Astro.props;

const num = services.find((s) => s.slug === slug)?.num ?? "";

const captions: Record<string, string> = {
  website: "One page, one thing worth clicking.",
  app: "The spreadsheet, given a shape.",
  automation: "It runs itself, on its own clock.",
  hosting: "Stacked, watched, answered at 03:14.",
  ai: "Forty layouts in, one shape out.",
  audit: "What it costs you now, in order.",
};
---

<figure class:list={["sketch", `is-${slug}`, animate && "is-live", className]}>
  <svg viewBox="0 0 200 120" fill="none" aria-hidden="true" focusable="false">
    {slug === "website" && (
      <>
        {/* A page, reduced to its frame and the one block worth clicking. */}
        <rect class="m-line l1" x="52" y="12" width="96" height="96" rx="14" pathLength="1" />
        <path class="m-line-2 l2" d="M52 42h96" pathLength="1" />
        <circle class="m-dim l3" cx="66" cy="27" r="4" />
        <circle class="m-dim l3" cx="80" cy="27" r="4" />
        <rect class="m-dim l4" x="68" y="56" width="64" height="10" rx="5" />
        <rect class="m-accent l5" x="68" y="78" width="44" height="18" rx="9" />

        <g class="hov">
          <circle class="tap" cx="90" cy="87" r="15" />
        </g>
      </>
    )}

    {slug === "app" && (
      <>
        {/* Four panels, one of them the thing you opened it for. */}
        <rect class="m-line l1" x="48" y="10" width="44" height="44" rx="9" pathLength="1" />
        <rect class="m-line l2" x="108" y="10" width="44" height="44" rx="9" pathLength="1" />
        <rect class="m-line l3" x="48" y="64" width="44" height="44" rx="9" pathLength="1" />
        <rect class="m-accent l4" x="108" y="64" width="44" height="44" rx="9" />

        <g class="hov">
          <rect class="sweep" x="44" y="6" width="5" height="106" rx="2.5" />
        </g>
      </>
    )}

    {slug === "automation" && (
      <>
        {/* A closed loop with a gap and an arrowhead: it comes back round on
            its own. The square on the ring is the thing being carried. */}
        <path class="m-line l1" d="M129.7 89.7A42 42 0 1 1 129.7 30.3" pathLength="1" />
        <path class="m-line l2" d="M113.4 26.8L129.7 30.3L126.2 14" pathLength="1" />
        <rect class="m-accent l3" x="91" y="93" width="18" height="18" rx="5" />
        <circle class="m-dim l4" cx="58" cy="60" r="5" />
        <circle class="m-dim l4" cx="100" cy="18" r="5" />

        <g class="hov">
          {/* Rotated about the ring's centre rather than its own, so it rides
              the ring. view-box, because the box being rotated about is the
              drawing's, not this square's. */}
          <g class="orbit">
            <rect x="93" y="11" width="14" height="14" rx="4" />
          </g>
        </g>
      </>
    )}

    {slug === "hosting" && (
      <>
        {/* Three tiers and three lights, one of which is the one you would
            ring someone about. */}
        <rect class="m-line l1" x="44" y="18" width="112" height="24" rx="7" pathLength="1" />
        <rect class="m-line l2" x="44" y="48" width="112" height="24" rx="7" pathLength="1" />
        <rect class="m-line l3" x="44" y="78" width="112" height="24" rx="7" pathLength="1" />
        <circle class="m-dim l4" cx="62" cy="60" r="5" />
        <circle class="m-dim l4" cx="62" cy="90" r="5" />
        <circle class="m-accent l5" cx="62" cy="30" r="6" />

        <g class="hov">
          <circle class="pulse" cx="62" cy="30" r="9" />
        </g>
      </>
    )}

    {slug === "ai" && (
      <>
        {/* Three hollow things in on one side, one solid thing out the other,
            and the part doing the work in the middle. */}
        <circle class="m-line l1" cx="100" cy="60" r="34" pathLength="1" />
        <path
          class="m-line-2 l2"
          d="M66 60H45M70.6 77L52.4 87.5M70.6 43L52.4 32.5M134 60h21"
          pathLength="1"
        />
        <rect class="m-line-2 l3" x="31" y="53" width="14" height="14" rx="4" pathLength="1" />
        <rect class="m-line-2 l3" x="39.3" y="84" width="14" height="14" rx="4" pathLength="1" />
        <rect class="m-line-2 l3" x="39.3" y="22" width="14" height="14" rx="4" pathLength="1" />
        <rect class="m-ink l4" x="155" y="53" width="14" height="14" rx="4" />
        <circle class="m-accent l5" cx="100" cy="60" r="13" />

        <g class="hov">
          <circle class="feed" cx="66" cy="60" r="5" />
        </g>
      </>
    )}

    {slug === "audit" && (
      <>
        {/* A lens, and under it the findings in the order they cost you. */}
        <circle class="m-line l1" cx="86" cy="50" r="34" pathLength="1" />
        <path class="m-line-heavy l2" d="M110 74L148 112" pathLength="1" />
        {/* Widest at the top, and the widest is the accent: the findings in
            the order they cost you, which is the whole pitch. */}
        <rect class="m-accent l3" x="68" y="28" width="42" height="12" rx="6" />
        <rect class="m-ink l4" x="68" y="46" width="34" height="10" rx="5" />
        <rect class="m-dim l5" x="68" y="62" width="24" height="10" rx="5" />

        <g class="hov">
          <circle class="probe" cx="86" cy="50" r="34" />
        </g>
      </>
    )}
  </svg>

  {caption && (
    <figcaption class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-faint mt-4">
      Fig. {num} <span class="text-ink-dim ml-1">{captions[slug]}</span>
    </figcaption>
  )}
</figure>

<style>
  .sketch {
    margin: 0;
  }
  .sketch svg {
    display: block;
    width: 100%;
    height: auto;
    /* The hover beats leave the box: the orbit rides the ring's outside and
       the taps expand past their shape. */
    overflow: visible;
  }

  /* ── Palette ─────────────────────────────────────────────────────────────
     Strokes scale with the figure rather than holding a pixel width. These are
     marks: at the size they run on the services page a hairline would read as
     a diagram again, which is the thing we moved away from. */
  .sketch .m-line,
  .sketch .m-line-2,
  .sketch .m-line-heavy {
    stroke: var(--color-rule-strong);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Rule 2. One dash covering the whole path, so at rest the shape is solid
       and the build is a matter of offsetting it. */
    stroke-dasharray: 1;
  }
  .sketch .m-line {
    stroke-width: 5;
  }
  .sketch .m-line-2 {
    stroke-width: 4;
  }
  .sketch .m-line-heavy {
    stroke-width: 7;
  }
  .sketch .m-dim {
    fill: #2b2b2b;
  }
  .sketch .m-ink {
    fill: var(--color-ink-faint);
  }
  .sketch .m-accent {
    fill: var(--color-accent);
  }

  /* Rule 1, and every part scales about its own middle. */
  .sketch .l1,
  .sketch .l2,
  .sketch .l3,
  .sketch .l4,
  .sketch .l5,
  .sketch .hov > * {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  /* ── The five lanes ──────────────────────────────────────────────────────
     Identical shape, shifted entry, near-shared exit:

       lane   in     complete   out    gone
       1       1%       8.5%     91%    95%
       2       3%      10.5%     92%    96%
       3       5%      12.5%     93%    97%
       4       7%      14.5%     94%    98%
       5       9%      16.5%     95%    99%

     Which leaves every mark standing complete from 16.5% to 91% of its cycle:
     on an 11 second loop, about a second building, eight standing, half a
     second leaving.

     The windows are deliberately a small slice of a long cycle rather than a
     big slice of a short one. Six of these run on the homepage at once, and
     the difference between them being alive and being a nuisance is almost
     entirely how much of the time anything is moving.

     Timing sits inside the keyframes rather than on the shorthand: an arrival,
     an impact and a departure all want different curves, and one curve across
     all three is most of what makes a build read as mechanical. Each part
     comes in under its own size, punches past it, and settles back. */
  @keyframes mark-1 {
    0%,
    1% {
      opacity: 0;
      transform: scale(0.4);
      stroke-dashoffset: 1;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    2% {
      opacity: 1;
    }
    5.5% {
      opacity: 1;
      transform: scale(1.13);
      stroke-dashoffset: 0.18;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    7% {
      transform: scale(0.955);
      stroke-dashoffset: 0;
    }
    8.5%,
    91% {
      opacity: 1;
      transform: scale(1);
      stroke-dashoffset: 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.2);
    }
    95%,
    100% {
      opacity: 0;
      transform: scale(0.5);
      stroke-dashoffset: 1;
    }
  }
  @keyframes mark-2 {
    0%,
    3% {
      opacity: 0;
      transform: scale(0.4);
      stroke-dashoffset: 1;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    4% {
      opacity: 1;
    }
    7.5% {
      opacity: 1;
      transform: scale(1.13);
      stroke-dashoffset: 0.18;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    9% {
      transform: scale(0.955);
      stroke-dashoffset: 0;
    }
    10.5%,
    92% {
      opacity: 1;
      transform: scale(1);
      stroke-dashoffset: 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.2);
    }
    96%,
    100% {
      opacity: 0;
      transform: scale(0.5);
      stroke-dashoffset: 1;
    }
  }
  @keyframes mark-3 {
    0%,
    5% {
      opacity: 0;
      transform: scale(0.4);
      stroke-dashoffset: 1;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    6% {
      opacity: 1;
    }
    9.5% {
      opacity: 1;
      transform: scale(1.13);
      stroke-dashoffset: 0.18;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    11% {
      transform: scale(0.955);
      stroke-dashoffset: 0;
    }
    12.5%,
    93% {
      opacity: 1;
      transform: scale(1);
      stroke-dashoffset: 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.2);
    }
    97%,
    100% {
      opacity: 0;
      transform: scale(0.5);
      stroke-dashoffset: 1;
    }
  }
  @keyframes mark-4 {
    0%,
    7% {
      opacity: 0;
      transform: scale(0.4);
      stroke-dashoffset: 1;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    8% {
      opacity: 1;
    }
    11.5% {
      opacity: 1;
      transform: scale(1.13);
      stroke-dashoffset: 0.18;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    13% {
      transform: scale(0.955);
      stroke-dashoffset: 0;
    }
    14.5%,
    94% {
      opacity: 1;
      transform: scale(1);
      stroke-dashoffset: 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.2);
    }
    98%,
    100% {
      opacity: 0;
      transform: scale(0.5);
      stroke-dashoffset: 1;
    }
  }
  @keyframes mark-5 {
    0%,
    9% {
      opacity: 0;
      transform: scale(0.4);
      stroke-dashoffset: 1;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    10% {
      opacity: 1;
    }
    13.5% {
      opacity: 1;
      transform: scale(1.13);
      stroke-dashoffset: 0.18;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    15% {
      transform: scale(0.955);
      stroke-dashoffset: 0;
    }
    16.5%,
    95% {
      opacity: 1;
      transform: scale(1);
      stroke-dashoffset: 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0.2);
    }
    99%,
    100% {
      opacity: 0;
      transform: scale(0.5);
      stroke-dashoffset: 1;
    }
  }

  .sketch.is-live .l1 { animation: mark-1 var(--dur) linear infinite both; }
  .sketch.is-live .l2 { animation: mark-2 var(--dur) linear infinite both; }
  .sketch.is-live .l3 { animation: mark-3 var(--dur) linear infinite both; }
  .sketch.is-live .l4 { animation: mark-4 var(--dur) linear infinite both; }
  .sketch.is-live .l5 { animation: mark-5 var(--dur) linear infinite both; }

  /* Six loops on one page. Prime-ish durations so they drift apart rather than
     falling into step and turning the plate into one big pulse. */
  .sketch.is-website { --dur: 11s; }
  .sketch.is-app { --dur: 10.6s; }
  .sketch.is-automation { --dur: 12s; }
  .sketch.is-hosting { --dur: 11.4s; }
  .sketch.is-ai { --dur: 12.6s; }
  .sketch.is-audit { --dur: 11.8s; }

  /* ── Hover ───────────────────────────────────────────────────────────────
     Rule 3: dedicated elements, invisible otherwise, so the loop underneath is
     never interrupted and there is nothing to jump back from.

     Two triggers: the homepage plate, where the card is one big link, and the
     services page, where the mark sits in a static panel. */
  .sketch .hov > * {
    opacity: 0;
  }
  .sketch .tap,
  .sketch .pulse,
  .sketch .probe {
    stroke: var(--color-accent);
    stroke-width: 3;
    fill: none;
  }
  .sketch .sweep,
  .sketch .feed,
  .sketch .orbit rect {
    fill: var(--color-accent);
  }
  .sketch .orbit {
    /* The centre it turns about is the ring's, not its own, so this one reads
       against the drawing rather than against its own little box. */
    transform-box: view-box;
    transform-origin: 100px 60px;
  }

  @keyframes hv-tap {
    0% { opacity: 0; transform: scale(0.35); }
    45% { opacity: 0.9; transform: scale(1.1); }
    100% { opacity: 0; transform: scale(1.75); }
  }
  @keyframes hv-sweep {
    0% { opacity: 0; transform: translateX(0); }
    12% { opacity: 0.85; }
    82% { opacity: 0.85; }
    100% { opacity: 0; transform: translateX(104px); }
  }
  @keyframes hv-orbit {
    0% { opacity: 0; transform: rotate(0deg); }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; transform: rotate(360deg); }
  }
  @keyframes hv-pulse {
    0% { opacity: 0; transform: scale(0.5); }
    40% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(2.1); }
  }
  @keyframes hv-feed {
    0% { opacity: 0; transform: translateX(-22px) scale(0.6); }
    18% { opacity: 1; transform: translateX(-14px) scale(1); }
    76% { opacity: 1; transform: translateX(20px) scale(1); }
    100% { opacity: 0; transform: translateX(26px) scale(0.4); }
  }
  @keyframes hv-probe {
    0% { opacity: 0; transform: scale(1.16); }
    35% { opacity: 0.95; transform: scale(1.04); }
    100% { opacity: 0; transform: scale(0.94); }
  }

  .sketch.is-live.is-website:hover .tap,
  :global(.group:hover) .sketch.is-live.is-website .tap {
    animation: hv-tap 0.9s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  .sketch.is-live.is-app:hover .sweep,
  :global(.group:hover) .sketch.is-live.is-app .sweep {
    animation: hv-sweep 1s cubic-bezier(0.4, 0, 0.35, 1) forwards;
  }
  .sketch.is-live.is-automation:hover .orbit,
  :global(.group:hover) .sketch.is-live.is-automation .orbit {
    animation: hv-orbit 1.4s cubic-bezier(0.45, 0, 0.3, 1) forwards;
  }
  .sketch.is-live.is-hosting:hover .pulse,
  :global(.group:hover) .sketch.is-live.is-hosting .pulse {
    animation: hv-pulse 1s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  .sketch.is-live.is-ai:hover .feed,
  :global(.group:hover) .sketch.is-live.is-ai .feed {
    animation: hv-feed 0.95s cubic-bezier(0.35, 0, 0.3, 1) forwards;
  }
  .sketch.is-live.is-audit:hover .probe,
  :global(.group:hover) .sketch.is-live.is-audit .probe {
    animation: hv-probe 0.9s cubic-bezier(0.3, 0.8, 0.3, 1) forwards;
  }

  /* Nothing runs until the section holding it has been revealed, so six marks
     below the fold are not looping at people who never scroll. Gated on .js:
     without it .is-visible never arrives and they would freeze mid-build. */
  :global(html.js [data-reveal]:not(.is-visible)) .sketch * {
    animation-play-state: paused !important;
  }

  /* The finished mark is the resting state — solid strokes, no transform — so
     stopping the animations is the whole of what this needs to do. */
  @media (prefers-reduced-motion: reduce) {
    .sketch * {
      animation: none !important;
    }
  }
</style>
