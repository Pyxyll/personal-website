---
/**
 * Two skills that belong to one stage of the work, in one cell of the
 * homepage plate.
 *
 * Automation and infrastructure are both what happens after something ships:
 * one keeps the data moving, the other keeps the lights on. Putting them in
 * one cell says that, and it gives the plate a third kind of cell: two
 * sideways rows, each its own link, with a hairline between them. The footers
 * are inline here rather than plates, the index register rather than the card
 * register, which is the variance the row needs against the two standard
 * cards beside it.
 */
import CornerNodes from "./CornerNodes.astro";
import SkillSketch from "./SkillSketch.astro";
import type { Skill } from "../lib/skills";

interface Props {
  skills: [Skill, Skill];
}
const { skills } = Astro.props;
---

<div class="relative flex flex-col border-b border-r border-rule md:col-span-2 lg:col-span-6">
  <CornerNodes />
  {skills.map((skill, i) => (
    <a
      href={`/skills/#${skill.slug}`}
      class:list={[
        "group grid flex-1 gap-5 p-6 sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:items-center transition-colors duration-300 hover:bg-paper-2",
        i > 0 && "border-t border-rule",
      ]}
    >
      <SkillSketch slug={skill.slug} class="opacity-90 transition-opacity group-hover:opacity-100" />
      <div data-copy class="flex flex-col gap-1.5">
        <h3 class="text-lg font-semibold tracking-tight leading-snug m-0">{skill.title}</h3>
        <p class="text-sm text-ink-dim leading-relaxed m-0">{skill.tagline}</p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="font-mono text-xs leading-none text-ink-dim whitespace-nowrap">
            {skill.tools.slice(0, 3).join(" · ")}
          </span>
          <span class="inline-flex items-center gap-1.5 text-[13px] font-medium whitespace-nowrap text-accent-text transition-colors duration-300 group-hover:text-ink">
            In detail
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  ))}
</div>
