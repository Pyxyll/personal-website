---
import { getCollection } from "astro:content";
import NavMenu from "./NavMenu";
import type { MenuPanel } from "./NavMenu";
import { skills } from "../lib/skills";

const { pathname } = Astro.url;

// The CV is not in this list because it is the pill on the right: the one
// thing the bar asks you to do, and the one thing left when it collapses.
const items = [
  { href: "/skills/", label: "Skills" },
  { href: "/work/", label: "Work" },
  { href: "/contact/", label: "Contact" },
];
const isActive = (item: (typeof items)[number]) => pathname.startsWith(item.href);

// Panel data, resolved at build time and handed to the island as plain props.
// Both panels are the same shape, so the menu draws them with one template.
const skillsPanel: MenuPanel = {
  heading: "Skills",
  blurb: "Six things I do, and where on this site you can see each one.",
  all: { href: "/skills/", label: "All six, in detail" },
  items: skills.map((s) => ({
    href: `/skills/#${s.slug}`,
    title: s.title,
    description: s.tagline,
  })),
};

// Six pieces of work: the ones chosen for the homepage first, in that order,
// then the newest of the rest. A menu, not a directory: the rest live on /work/.
const work = await getCollection("work");
const menuWork = [
  ...work
    .filter((e) => e.data.featured !== undefined)
    .sort((a, b) => a.data.featured! - b.data.featured!),
  ...work
    .filter((e) => e.data.featured === undefined)
    .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt),
].slice(0, 6);
const workPanel: MenuPanel = {
  heading: "Work",
  blurb: "Things I've built: for the day job, for clients, and because I wanted them to exist.",
  all: { href: "/work/", label: "All work" },
  items: menuWork.map((e) => ({
    href: `/work/${e.id}/`,
    title: e.data.title,
    description: e.data.summary,
  })),
};
---

{/* Sticky, because the scrolled state is the point: past the fold this
    collapses to just the mark and the CTA over whatever you are reading.
    Three columns with equal outer tracks, so the links sit on the true centre
    of the page rather than the centre of whatever space the mark and the
    button leave. Below sm the links are gone and it is two columns.

    The three sit on one baseline, not on their centres. They are three sizes
    of type, and centring boxes of different sizes leaves the smaller text
    riding high: measured, the links sat 3.5px above the wordmark. The row is
    then centred in the bar as a whole. */}
<nav id="site-nav" data-scrolled="false" aria-label="Primary">
  <div class="mx-auto max-w-shell px-6 lg:px-10">
    <div class="grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_auto_1fr] items-baseline content-center gap-4 h-20">
      {/* The wordmark: first name light, surname bold, run together with no
          space, and closed with the hero's pink full stop. The two weights do
          the job the space would have. Read aloud that would come out as one
          word, so the link carries the name properly spaced. */}
      <a href="/" class="nav-mark justify-self-start" aria-label="Dylan Collins, home">
        <span class="nav-mark-word" aria-hidden="true"><span class="nav-mark-first">Dylan</span><span class="nav-mark-last">Collins</span><span class="nav-mark-stop">.</span></span>
      </a>

      {/* client:media matches the CSS breakpoint that shows this at all, so
          phones never download React or Radix for a menu they cannot see. The
          triggers render as plain links server-side, so the bar is navigable
          before (and without) hydration either way. */}
      <div class="nav-center hidden sm:flex justify-center">
        <NavMenu
          client:media="(min-width: 640px)"
          skills={skillsPanel}
          work={workPanel}
          pathname={pathname}
        />
      </div>

      <div class="flex items-center gap-3 sm:gap-4 justify-self-end">
        <a href="/cv/" class="nav-cta" aria-current={pathname.startsWith("/cv/") ? "page" : undefined}>View CV</a>

        {/* Mobile trigger */}
        <button
          id="nav-toggle"
          type="button"
          class="sm:hidden text-sm font-medium text-ink-dim hover:text-ink transition-colors px-2 py-2 -mr-2"
          aria-expanded="false"
          aria-controls="nav-overlay"
          aria-label="Open menu"
        >
          Menu
        </button>
      </div>
    </div>
  </div>

  {/* Mobile overlay */}
  <div
    id="nav-overlay"
    class="fixed inset-0 z-50 bg-paper text-ink sm:hidden flex flex-col"
    aria-hidden="true"
    data-open="false"
    style="visibility: hidden; opacity: 0; transition: opacity 0.25s ease, visibility 0s linear 0.25s;"
  >
    <div class="flex items-center justify-between px-6 h-20 border-b border-rule">
      <a href="/" class="nav-mark" data-nav-link aria-label="Dylan Collins, home">
        <span class="nav-mark-word" aria-hidden="true"><span class="nav-mark-first">Dylan</span><span class="nav-mark-last">Collins</span><span class="nav-mark-stop">.</span></span>
      </a>
      <button
        id="nav-close"
        type="button"
        class="text-sm font-medium text-ink-dim hover:text-ink transition-colors px-2 py-2 -mr-2"
        aria-label="Close menu"
      >
        Close
      </button>
    </div>

    <ul class="flex-1 flex flex-col justify-center gap-2 px-6 py-12">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            data-nav-link
            class:list={[
              "group flex items-baseline gap-4 py-4 border-b border-rule",
              isActive(item) ? "text-ink" : "text-ink-dim",
            ]}
          >
            <span class="text-3xl tracking-tight font-medium">
              {item.label}
            </span>
            {isActive(item) && (
              <span class="ml-auto h-1 w-1 rounded-full bg-accent self-center"></span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="px-6 pb-6">
      <a href="/cv/" data-nav-link class="nav-cta w-full justify-center py-4">
        View CV
      </a>
    </div>

    <footer class="px-6 py-6 border-t border-rule flex justify-between font-mono text-xs uppercase tracking-widest text-ink-faint">
      <a href="mailto:hello@dylancollins.me" data-nav-link class="hover:text-ink transition-colors">Email</a>
      <a href="/rss.xml" data-nav-link class="hover:text-ink transition-colors">RSS</a>
    </footer>
  </div>
</nav>

{/* Global, not scoped: Astro's scoping cannot reach inside the React island's
    DOM, and the bar and the panels have to be styled as one thing. */}
<style is:global>
  #site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-paper);
    transition: background-color 0.3s ease;
  }


  /* Scrolled: the links step aside and the bar gets out of the way of the
     page. visibility, not just opacity, so the hidden links leave the tab
     order too rather than becoming invisible focus traps. */
  #site-nav[data-scrolled="true"] {
    background: transparent;
  }

  .nav-center {
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0s;
  }
  #site-nav[data-scrolled="true"] .nav-center {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
  }

  .nav-mark {
    display: inline-flex;
    align-items: center;
    margin: -0.5rem;
    padding: 0.5rem;
  }
  .nav-mark-word {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }
  .nav-mark-first {
    font-weight: 300;
  }
  .nav-mark-last {
    font-weight: 800;
  }
  /* The hero's full stop, in the hero's weight and the brand colour. */
  .nav-mark-stop {
    font-weight: 900;
    color: var(--color-accent);
    transition: color 0.2s ease;
  }
  .nav-mark:hover .nav-mark-stop {
    color: var(--color-accent-deep);
  }
  .nav-mark:hover .nav-mark-word {
    color: var(--color-ink-dim);
  }

  /* The one filled thing in the bar, and the only pill on the site, so it
     reads as the one thing the bar is asking you to do. Solid white so it
     carries the same weight at the right-hand end as the bold half of the
     wordmark does at the left, with the quiet links between them. Set in the
     links' own type and size: it used to be wide-tracked mono capitals, which
     made it the largest object in the bar and the odd one out. Pink on hover. */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-ink);
    border-radius: 9999px;
    padding: 0.4375rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25rem;
    white-space: nowrap;
    background: var(--color-ink);
    color: var(--color-paper);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .nav-cta:hover,
  .nav-cta[aria-current="page"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    /* White, not paper: on the brand pink white is 4.7:1 and paper only 4.2:1.
       That flips the other way on a lighter accent, so it tracks the token. */
    color: #ffffff;
  }

  /* ── Mega menu ──────────────────────────────────────────────────────── */

  /* Static, so the sticky nav is the containing block for the panel and it can
     centre on the page rather than on the trigger group. */
  .nav-menu {
    position: static;
  }
  .nav-menu-list {
    display: flex;
    align-items: center;
    /* Each link also carries 0.75rem of padding a side for the highlight to
       sit in, so this is 2.5rem of clear space between one word and the next. */
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    /* A step up from 14px, so the jump from the 19px wordmark is not so steep. */
    font-size: 0.9375rem;
    color: var(--color-ink-dim);
    transition: color 0.2s ease;
  }
  .nav-trigger:hover,
  .nav-trigger[data-state="open"],
  .nav-trigger.is-active {
    color: var(--color-ink);
  }

  /* Underline marks the current page only. Hover and open are a change of
     colour, the same as every other link on the site. */
  /* The underline hangs below the label rather than sitting in padding under
     it: padding there made the label's box taller than its text and lifted
     the word off the line the rest of the bar sits on. */
  .nav-trigger-label {
    position: relative;
    display: inline-block;
  }
  .nav-trigger-label::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-trigger.is-active .nav-trigger-label::after {
    transform: scaleX(1);
  }

  .nav-chevron {
    flex: none;
    color: var(--color-ink-faint);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease;
  }
  .nav-trigger:hover .nav-chevron,
  .nav-trigger[data-state="open"] .nav-chevron {
    color: var(--color-ink-dim);
  }
  .nav-trigger[data-state="open"] .nav-chevron {
    transform: rotate(180deg);
  }

  /* The panel surface. Full width of the bar, so the viewport can centre the
     measured panel on the page. */
  .nav-viewport-slot {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .nav-viewport {
    position: relative;
    overflow: hidden;
    pointer-events: auto;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    /* Detached from the bar so all four corners can round. Radix keeps the
       menu open while the pointer crosses this gap. */
    margin-top: 0.5rem;
    border-radius: 14px;
    transform-origin: top center;
    /* Radix measures each panel and publishes its box here; transitioning
       these is what makes one surface morph between Skills and Work. */
    width: var(--radix-navigation-menu-viewport-width);
    height: var(--radix-navigation-menu-viewport-height);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-viewport[data-state="open"] {
    animation: navViewportIn 0.2s ease;
  }
  .nav-viewport[data-state="closed"] {
    animation: navViewportOut 0.2s ease;
  }
  @keyframes navViewportIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @keyframes navViewportOut {
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* Deliberately no width here. Radix sizes the viewport by measuring this
     element, so giving it width:100% makes the two size off each other and
     both collapse to zero: you get the viewport's border and nothing inside
     it. Left to shrink-to-fit, it takes its width from .nav-panel-inner. */
  .nav-panel {
    position: absolute;
    top: 0;
    left: 0;
  }
  /* Direction of travel, so the incoming panel slides in from the side you
     came from rather than appearing. */
  .nav-panel[data-motion="from-start"] {
    animation: navFromLeft 0.25s ease;
  }
  .nav-panel[data-motion="from-end"] {
    animation: navFromRight 0.25s ease;
  }
  .nav-panel[data-motion="to-start"] {
    animation: navToLeft 0.25s ease;
  }
  .nav-panel[data-motion="to-end"] {
    animation: navToRight 0.25s ease;
  }
  @keyframes navFromLeft {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
  }
  @keyframes navFromRight {
    from {
      opacity: 0;
      transform: translateX(14px);
    }
  }
  @keyframes navToLeft {
    to {
      opacity: 0;
      transform: translateX(-14px);
    }
  }
  @keyframes navToRight {
    to {
      opacity: 0;
      transform: translateX(14px);
    }
  }

  /* ── A panel ─────────────────────────────────────────────────────────
     One layout for both: a lead column, then the cells. The viewport's own
     border and radius are the panel's edge, so there is no second box inside
     the first. */
  .nav-panel-inner {
    width: min(60rem, calc(100vw - 3rem));
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    overflow: hidden;
  }

  .nav-lead {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
  }
  .nav-lead-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .nav-lead-blurb {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-dim);
  }
  /* The site's action: accent text and its arrow, lifting to ink on hover. */
  .nav-lead-action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent-text);
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-lead-action:hover {
    color: var(--color-ink);
  }

  /* Two columns of cells, ruled off from the lead and from each other. Each
     cell draws its own right and bottom hairline; the list is pulled a pixel
     past the panel's edge on those two sides and the panel crops it, so the
     outer lines never double up against the viewport's border. */
  .nav-cells {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0 -1px -1px 0;
    padding: 0;
    border-left: 1px solid var(--color-rule);
  }
  .nav-cells > li {
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .nav-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1.125rem 1.25rem;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-cell:hover,
  .nav-cell:focus-visible {
    background: var(--color-paper-2);
  }
  .nav-cell-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
  }
  /* Hover shifts colour only: the arrow is always there, and comes up from
     nothing rather than sliding in. */
  .nav-cell-arrow {
    flex: none;
    color: var(--color-accent-text);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-cell:hover .nav-cell-arrow,
  .nav-cell:focus-visible .nav-cell-arrow {
    opacity: 1;
  }
  .nav-cell-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Narrow bars: no room for a column beside the cells, so the lead becomes a
     strip across the top with its name and its link, and the sentence goes. */
  @media (max-width: 899px) {
    .nav-panel-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .nav-lead {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--color-rule);
    }
    .nav-lead-blurb {
      display: none;
    }
    .nav-lead-action {
      margin-top: 0;
      padding-top: 0;
    }
    .nav-cells {
      border-left: 0;
    }
  }
</style>

<script>
  // Collapse the bar once you are past the top of the page. The links come
  // back at the top, so they are never permanently out of reach for anyone
  // navigating by keyboard.
  const nav = document.getElementById("site-nav");
  if (nav) {
    const THRESHOLD = 24;
    let ticking = false;

    const sync = () => {
      nav.dataset.scrolled = String(window.scrollY > THRESHOLD);
      ticking = false;
    };

    sync(); // a restored scroll position or an #anchor load starts mid-page
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(sync);
      },
      { passive: true }
    );
  }

  // Mobile nav overlay. Vanilla JS, no React island needed.
  const toggle = document.getElementById("nav-toggle");
  const overlay = document.getElementById("nav-overlay");
  const close = document.getElementById("nav-close");

  if (toggle && overlay && close) {
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      overlay.dataset.open = "true";
      overlay.style.visibility = "visible";
      overlay.style.opacity = "1";
      overlay.style.transition = "opacity 0.25s ease";
      overlay.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      // Move focus to close button after the fade
      window.setTimeout(() => close.focus(), 50);
    };

    const closeMenu = () => {
      overlay.dataset.open = "false";
      overlay.style.opacity = "0";
      overlay.style.transition = "opacity 0.25s ease, visibility 0s linear 0.25s";
      window.setTimeout(() => {
        overlay.style.visibility = "hidden";
      }, 250);
      overlay.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      lastFocused?.focus();
    };

    toggle.addEventListener("click", () => {
      if (overlay.dataset.open === "true") closeMenu();
      else open();
    });
    close.addEventListener("click", closeMenu);

    // Close on link click (any nav link within the overlay)
    overlay.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((a) => {
      a.addEventListener("click", () => closeMenu());
    });

    // ESC to close
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.dataset.open === "true") closeMenu();
    });

    // If the viewport widens past sm (~640px), ensure overlay is closed and body is scrollable.
    const mq = window.matchMedia("(min-width: 640px)");
    const onChange = () => {
      if (mq.matches && overlay.dataset.open === "true") closeMenu();
    };
    if ("addEventListener" in mq) mq.addEventListener("change", onChange);
  }
</script>
