---
/**
 * One cell of the homepage skills plate.
 *
 * Three variants, and each one says something true about the skill it holds
 * rather than decorating it:
 *
 *   lead       the main thing I do. Spans the width of two peers and turns
 *              sideways: the drawing on the left, the copy on the right.
 *   highlight  the one to notice. An inversion plate: light on a dark page.
 *              The drawing flips its ink to match and the pink stays pink.
 *   peer       the rest of the range. The standard card.
 *
 * Every variant ends in the site's arrow, bottom right, nudging on hover:
 * the same cue the work cards use, since the whole card is the link. The
 * tools are left off; on the homepage the work cards carry the stack, and
 * /skills/ lists them in full.
 *
 * `fill` is for the last of a row of three peers: at tablet width, where
 * the plate has two columns, it spans both and turns sideways like the
 * highlight, so the row closes without a gap.
 */
import ArrowIcon from "./ArrowIcon.astro";
import CornerNodes from "./CornerNodes.astro";
import SkillSketch from "./SkillSketch.astro";
import type { Skill } from "../lib/skills";

interface Props {
  skill: Skill;
  variant?: "lead" | "highlight" | "peer";
  fill?: boolean;
}
const { skill, variant = "peer", fill = false } = Astro.props;
const inverted = variant === "highlight";

const span = {
  lead: "md:col-span-2 lg:col-span-8",
  highlight: "md:col-span-2 lg:col-span-4",
  peer: fill ? "md:col-span-2 lg:col-span-4" : "lg:col-span-4",
}[variant];

/* How the drawing and the copy sit. The lead is sideways from small screens
   up. The highlight is sideways only at tablet width, where it spans the
   plate, and stacks again beside the lead on large screens. Peers stack. */
const layout = {
  lead: "sm:grid-cols-2 sm:items-center",
  highlight: "md:grid-cols-2 md:items-center lg:grid-cols-1 lg:items-start",
  peer: fill ? "md:grid-cols-2 md:items-center lg:grid-cols-1 lg:items-start" : "",
}[variant];

/* The light plate uses the brief's own ink and greys. They are literal here
   rather than tokens because nothing else on the site is light. */
const tone = inverted
  ? {
      card: "bg-[#fafafa] text-[#262626] hover:bg-white [--scrim:#ffffff]",
      dim: "text-[#595959]",
    }
  : {
      card: "hover:bg-paper-2",
      dim: "text-ink-dim",
    };
---

<a
  href={`/skills/#${skill.slug}`}
  class:list={[
    "group relative flex flex-col gap-5 border-b border-r border-rule p-6 transition-colors duration-300",
    span,
    tone.card,
  ]}
>
  <CornerNodes />

  <div class:list={["grid flex-1 gap-6", layout]}>
    <SkillSketch
      slug={skill.slug}
      inverted={inverted}
      class="opacity-90 transition-opacity group-hover:opacity-100"
    />
    <div data-copy class:list={["flex flex-col", variant === "lead" ? "gap-3" : "gap-1.5"]}>
      <h3 class:list={["font-semibold tracking-tight leading-snug m-0", variant === "lead" ? "text-xl" : "text-lg"]}>
        {skill.title}
      </h3>
      <p class:list={["text-sm leading-relaxed m-0", tone.dim]}>{skill.tagline}</p>
      {variant === "lead" && (
        <p class:list={["hidden lg:block text-sm leading-relaxed m-0 max-w-[36ch]", tone.dim]}>{skill.body}</p>
      )}
    </div>
  </div>

  <span
    aria-hidden="true"
    class="mt-auto self-end flex items-center text-accent transition-transform duration-300 group-hover:translate-x-1"
  >
    <ArrowIcon />
  </span>
</a>
