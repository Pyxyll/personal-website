---
import Base from "../layouts/Base.astro";
import HeroShader from "../components/HeroShader";
import SectionHeader from "../components/SectionHeader.astro";
import FramedSection from "../components/FramedSection.astro";
import CornerNodes from "../components/CornerNodes.astro";
import RotatingWord from "../components/RotatingWord";
import EmptyState from "../components/EmptyState.astro";
import Schema from "../components/Schema.astro";
import SkillCard from "../components/SkillCard.astro";
import SkillPair from "../components/SkillPair.astro";
import AiLoop from "../components/AiLoop.astro";
import ExperiencePlate from "../components/ExperiencePlate.astro";
import OpenToWork from "../components/OpenToWork.astro";
import WorkStack from "../components/WorkStack.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import { getCollection } from "astro:content";
import { personSchema, websiteSchema } from "../lib/schema";
import { skills } from "../lib/skills";

const bySlug = (slug: string) => skills.find((s) => s.slug === slug)!;

const writingEntries = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)
  .slice(0, 3);

/* Entries with a `featured` position lead, in that order; the newest of the
   rest fill whatever is left of the four. */
const allWork = await getCollection("work");
const workEntries = [
  ...allWork
    .filter((e) => e.data.featured !== undefined)
    .sort((a, b) => a.data.featured! - b.data.featured!),
  ...allWork
    .filter((e) => e.data.featured === undefined)
    .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt),
].slice(0, 4);
/* The bento's wide cells are the first and the last. A wide card with no
   screenshots is mostly empty, so if the last entry has none and the one
   before it does, they swap. Otherwise the order above stands. */
if (workEntries.length === 4 && !workEntries[3].data.images?.length && workEntries[2].data.images?.length) {
  [workEntries[2], workEntries[3]] = [workEntries[3], workEntries[2]];
}

const dateShort = new Intl.DateTimeFormat("en-IE", {
  month: "short",
  year: "numeric",
});
const dateDay = new Intl.DateTimeFormat("en-IE", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
/** Minutes at a reading pace of about 220 words, never less than one. */
const readingTime = (body: string | undefined) =>
  Math.max(1, Math.round((body ?? "").trim().split(/\s+/).length / 220));
---

<Base>
  <Schema
    slot="head"
    data={[personSchema({ knowsAbout: skills.map((s) => s.title) }), websiteSchema()]}
  />
  {/* ── HERO ───────────────────────────────────────────────────────── */}
  {/* The section runs the full width so the rules above and below can cross
      the whole browser; the panel inside stays on the shell measure, level
      with the nav and with the rails further down. */}
  <section class="pt-5 sm:pt-7 flex flex-col gap-3 sm:gap-4">
    <div class="rule-dashed" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-shell px-6 lg:px-10">
      <div class="relative isolate flex flex-col justify-end min-h-[26rem] overflow-hidden rounded-[20px] border border-rule">
      {/* Clipped by the box: overflow-hidden plus the radius crops the shader's
          canvas to the rounded corners, and the box is positioned so it counts
          as the containing block for it. */}
      <HeroShader client:load />

      {/* Scrim. The shader's pink drifts under the hero copy, and at its densest
          it drags the secondary line down to roughly 3:1. This holds the type on
          near-solid paper without touching the part of the field you actually
          see, which sits higher up. */}
      <div
        class="absolute inset-0 z-[1] pointer-events-none bg-gradient-to-t from-paper from-0% via-paper/65 via-38% to-transparent to-72%"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 w-full px-6 sm:px-10 lg:px-14 pt-20 sm:pt-28 pb-16 sm:pb-20">
        <div class="grid grid-cols-12 gap-6 lg:gap-10 items-end">
          <div class="hidden lg:block lg:col-span-2"></div>

          <div class="col-span-12 lg:col-span-10 flex flex-col gap-8 sm:gap-10">
            <h1 class="display text-[clamp(3.25rem,11vw,9rem)] lift lift-1">
              <span class="block">Dylan</span>
              <span class="block">Collins<span class="text-accent">.</span></span>
            </h1>

            <div class="flex flex-col gap-6 max-w-2xl">
              <div class="flex flex-col gap-2 lift lift-2">
                <p class="text-lg sm:text-xl text-ink-dim">
                  Engineer, builder, curious.
                </p>
                <p class="text-base sm:text-lg text-ink-dim">
                  I build web platforms end to end, run the servers they live
                  on, and work with AI tooling every day.
                </p>
              </div>

              <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3 lift lift-3">
                <a
                  href="/cv/"
                  class="link group inline-flex items-baseline gap-2 text-base sm:text-lg text-ink"
                >
                  View CV
                  <span aria-hidden="true" class="text-accent transition-transform group-hover:translate-x-1">→</span>
                </a>
                <a
                  href="/work/"
                  class="link inline-flex items-baseline gap-2 text-sm text-ink-dim"
                >
                  See work
                  <span aria-hidden="true">→</span>
                </a>
              </div>

              <OpenToWork detail class="lift lift-4" />
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>

    <div class="rule-dashed" aria-hidden="true"></div>
  </section>

  {/* ── THE RUN ────────────────────────────────────────────────────────
      One continuous framed region rather than five separate sections: the
      rails run unbroken from here to the foot of the page, and the content
      inside is divided by internal breaks. The blocks below are stacked on a
      plain gap for now — that gap is where the break goes once we know what
      it looks like. */}
  <FramedSection class="mt-3 sm:mt-4" minHeight="0">
    <div class="flex flex-col gap-24 sm:gap-32 py-20 sm:py-28">

      {/* ── What I do ────────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader>
          I can <RotatingWord client:visible words={["build", "fix", "ship", "automate", "run"]} /> that<span class="text-accent">.</span>
        </SectionHeader>

        {/* A plate of six skills in five cells, four kinds: the main one
            sideways across two thirds, the one to notice as an inverted plate
            beside it, two standard cards, and a paired cell holding the two
            that happen after launch. The wide cell sits left on the first row
            and right on the second. Cells draw their own bottom and right
            edge; the container supplies the top and left, so the box closes
            at any column count. */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 border-t border-l border-rule">
          <SkillCard skill={bySlug("app")} variant="lead" />
          <SkillCard skill={bySlug("ai")} variant="highlight" />
          <SkillCard skill={bySlug("website")} />
          <SkillCard skill={bySlug("audit")} />
          <SkillPair skills={[bySlug("automation"), bySlug("hosting")]} />
        </div>
        <div class="mt-6 font-mono text-xs uppercase tracking-widest">
          <a href="/skills/" class="link text-ink-dim">All six, in detail <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {/* ── Working with AI ──────────────────────────────────────────────
          Its own block, not just a card in the plate: it is the question
          every hiring conversation gets to now, so it gets a straight answer
          and a method, drawn in the order the method runs. */}
      <div data-reveal>
        <SectionHeader>
          The agent types. I read every line<span class="text-accent">.</span>
        </SectionHeader>

        <AiLoop />

        <div class="mt-6 font-mono text-xs uppercase tracking-widest">
          <a href="/skills/#ai" class="link text-ink-dim">How I use it, in detail <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {/* ── Selected work ────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Things I've built." />

        {workEntries.length === 0 ? (
          <EmptyState
            message="Case studies are being written up. In the meantime, reach out and I'll send recent samples."
            ctaHref="/contact/"
            ctaLabel="Get in touch"
          />
        ) : (
          <>
            {/* Bento on the same three columns as the skills plate: two
                thirds then one third, and the next row the other way round.
                Unlike the plate these are separate cards with air between
                them, each carrying its own border — so the joints belong to
                the grid as a whole, not to every cell. Absolutely positioned,
                so CornerNodes does not take a grid cell. */}
            <div class="relative grid grid-cols-1 lg:grid-cols-3 gap-3">
              <CornerNodes />
              {workEntries.map((entry, i) => {
                const wide = i % 3 === 0;
                /* Top right carries the accent fill. Text on it is solid
                   white throughout: on the brand pink only pure white clears
                   4.5:1 — 90% white is 4.0:1 — so the hierarchy inside this
                   one comes from size and weight rather than tone. */
                const filled = i === 1;
                /* Entries with screenshots carry a stack that fans on hover.
                   Wide cards set it beside the copy on large screens; narrow
                   ones put it above. Entries without stay as plain cards. */
                const images = entry.data.images ?? [];
                const stacked = images.length > 0;
                return (
                  <a
                    href={`/work/${entry.id}/`}
                    data-reveal
                    style={`--reveal-delay:${i * 0.12}s`}
                    class:list={[
                      "group flex flex-col gap-5 min-h-[20rem] rounded-[6px] border p-7 sm:p-8 transition-colors",
                      filled
                        ? "bg-accent border-accent text-white hover:bg-accent-deep"
                        : "border-rule hover:bg-paper-2",
                      wide && "lg:col-span-2",
                    ]}
                  >
                    {stacked && !wide && (
                      <WorkStack images={images} alt={`${entry.data.title}, three views`} onAccent={filled} />
                    )}
                    <div
                      class:list={[
                        "flex flex-col gap-6",
                        stacked && wide && "lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-center lg:gap-10",
                      ]}
                    >
                    <div class="flex flex-col gap-2">
                      <h3
                        class:list={[
                          "font-semibold tracking-tight leading-snug m-0",
                          wide
                            ? "text-[clamp(1.5rem,3vw,2.125rem)]"
                            : "text-[clamp(1.25rem,2.2vw,1.5rem)]",
                        ]}
                      >
                        {entry.data.title}
                      </h3>
                      <p
                        class:list={[
                          "leading-relaxed m-0",
                          filled ? "text-white" : "text-ink-dim",
                          wide ? "text-base max-w-xl" : "text-sm",
                        ]}
                      >
                        {entry.data.summary}
                      </p>
                    </div>
                    {stacked && wide && (
                      <WorkStack images={images} alt={`${entry.data.title}, three views`} onAccent={filled} />
                    )}
                    </div>

                    <div
                      class:list={[
                        "mt-auto flex items-baseline justify-between gap-4 border-t pt-4 font-mono text-xs uppercase tracking-widest",
                        filled ? "border-white/30 text-white" : "border-rule text-ink-faint",
                      ]}
                    >
                      <span class="truncate">
                        {entry.data.stack.slice(0, wide ? 3 : 2).join(" · ")}
                      </span>
                      <span class="flex items-baseline gap-3 shrink-0">
                        <time datetime={entry.data.publishedAt.toISOString().split("T")[0]}>
                          {entry.data.publishedAt.getFullYear()}
                        </time>
                        <span
                          aria-hidden="true"
                          class:list={[
                            "transition-transform group-hover:translate-x-1",
                            filled ? "text-white" : "text-accent",
                          ]}
                        >→</span>
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
            <div class="mt-6 font-mono text-xs uppercase tracking-widest">
              <a href="/work/" class="link text-ink-dim">All work <span aria-hidden="true">→</span></a>
            </div>
          </>
        )}
      </div>

      {/* ── Experience ───────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Where I've done it." />
        <ExperiencePlate />
      </div>

      {/* ── Writing ──────────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Notes from the keyboard." />

        {writingEntries.length === 0 ? (
          <EmptyState
            message="First posts are in the drafts folder. Notes on web, infra, and the things I build will land here."
            ctaHref="/writing/"
            ctaLabel="The writing page"
          />
        ) : (
          /* The newest note leads, as a card with its own standfirst and
             reading time. The next two sit beside it as compact rows in a
             second plate, with the route to everything else at the foot. When
             there is only one note the second plate says so, so the layout
             holds its shape from the first post onward. */
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-3">
            {(() => {
              const [lead, ...rest] = writingEntries;
              return (
                <>
                  <a
                    href={`/writing/${lead.id}/`}
                    data-reveal
                    class="group lg:col-span-8 flex flex-col gap-5 rounded-[6px] border border-rule p-7 sm:p-8 transition-colors hover:bg-paper-2"
                  >
                    <div class="flex items-center gap-3 font-mono text-[13px] text-ink-faint">
                      <time datetime={lead.data.publishedAt.toISOString().split("T")[0]}>
                        {dateDay.format(lead.data.publishedAt)}
                      </time>
                      <span aria-hidden="true">·</span>
                      <span>{readingTime(lead.body)} min read</span>
                    </div>
                    <h3 class="text-[clamp(1.5rem,3vw,2.125rem)] font-semibold tracking-tight leading-tight m-0 max-w-[26ch]">
                      {lead.data.title}
                    </h3>
                    <p class="text-base text-ink-dim leading-relaxed m-0 max-w-xl">{lead.data.description}</p>
                    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
                      <span class="flex flex-wrap gap-1.5">
                        {lead.data.tags.slice(0, 3).map((tag) => (
                          <span class="font-mono text-xs leading-none text-ink-dim bg-rule px-1.5 py-1">{tag}</span>
                        ))}
                      </span>
                      <span class="inline-flex items-center gap-1.5 text-[13px] font-medium text-accent-text transition-colors duration-300 group-hover:text-ink">
                        Read the note
                        <ArrowIcon />
                      </span>
                    </div>
                  </a>

                  <div class="lg:col-span-4 flex flex-col rounded-[6px] border border-rule divide-y divide-rule">
                    {rest.map((entry, i) => (
                      <a
                        href={`/writing/${entry.id}/`}
                        data-reveal
                        style={`--reveal-delay:${0.12 + i * 0.12}s`}
                        class="group flex flex-1 flex-col justify-end gap-2 p-6 transition-colors hover:bg-paper-2"
                      >
                        <span class="font-mono text-[13px] text-ink-faint">
                          {dateDay.format(entry.data.publishedAt)} · {readingTime(entry.body)} min
                        </span>
                        <span class="text-base font-medium tracking-tight leading-snug text-ink-dim transition-colors duration-300 group-hover:text-ink">
                          {entry.data.title}
                        </span>
                      </a>
                    ))}
                    {rest.length < 2 && (
                      <div data-reveal style="--reveal-delay:0.24s" class="flex flex-1 flex-col justify-end gap-2 p-6">
                        <p class="text-sm text-ink-dim leading-relaxed m-0">
                          More notes are in the drafts folder. The feed will have them first.
                        </p>
                      </div>
                    )}
                    <a
                      href="/writing/"
                      class="inline-flex items-center gap-1.5 p-6 text-[13px] font-medium text-accent-text transition-colors duration-300 hover:text-ink"
                    >
                      All writing
                      <ArrowIcon />
                    </a>
                  </div>
                </>
              );
            })()}
          </div>
        )}
      </div>

      {/* ── Now ──────────────────────────────────────────────────────── */}
      <div data-reveal>
        <p class="text-[clamp(1.5rem,3.5vw,1.875rem)] font-medium tracking-tight leading-snug max-w-3xl">
          A day job, a few side projects, and a long list I never quite get to.
        </p>
        <div class="mt-6 font-mono text-xs uppercase tracking-widest">
          <a href="/now/" class="link text-ink-dim">What I'm doing now <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {/* ── Say hi ───────────────────────────────────────────────────── */}
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-8" data-reveal>
        <div class="flex flex-col gap-3">
          <h2 class="display text-[clamp(2.75rem,7vw,4.5rem)] m-0">
            Say hi<span class="text-accent">.</span>
          </h2>
          <p class="text-ink-dim max-w-md">
            Hiring, or building something you want a hand with?{" "}
            <a href="/cv/" class="ilink">The CV</a> is the short version of me,
            and the <a href="/contact/" class="ilink">contact form</a> is two
            fields and a message.
          </p>
          <OpenToWork class="mt-2" />
        </div>
        <a
          href="/contact/"
          class="inline-flex items-center gap-3 self-start sm:self-end shrink-0 border border-rule-strong px-6 py-4 font-mono text-xs uppercase tracking-widest hover:border-accent hover:text-accent-text transition-colors"
        >
          Get in touch
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </FramedSection>

</Base>
