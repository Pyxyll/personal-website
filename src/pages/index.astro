---
import Base from "../layouts/Base.astro";
import HeroShader from "../components/HeroShader";
import SectionHeader from "../components/SectionHeader.astro";
import FramedSection from "../components/FramedSection.astro";
import CornerNodes from "../components/CornerNodes.astro";
import RotatingWord from "../components/RotatingWord";
import EmptyState from "../components/EmptyState.astro";
import Schema from "../components/Schema.astro";
import SkillCard from "../components/SkillCard.astro";
import ExperiencePlate from "../components/ExperiencePlate.astro";
import OpenToWork from "../components/OpenToWork.astro";
import WorkStack from "../components/WorkStack.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import TechIcon from "../components/TechIcon.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import Endorsement from "../components/Endorsement.astro";
import NowPlate from "../components/NowPlate.astro";
import { getCollection } from "astro:content";
import { personSchema, websiteSchema } from "../lib/schema";
import { skills } from "../lib/skills";
import { cv } from "../lib/cv";
import { approvedEndorsements } from "../lib/endorsements";

const award = cv.awards[0];
const [endorsement] = approvedEndorsements;
const bySlug = (slug: string) => skills.find((s) => s.slug === slug)!;

/* Entries with a `featured` position lead, in that order; the newest of the
   rest follow. Four go on the page; the fifth cell of the grid is the way to
   the rest, and names them. */
const allWork = await getCollection("work");
const orderedWork = [
  ...allWork
    .filter((e) => e.data.featured !== undefined)
    .sort((a, b) => a.data.featured! - b.data.featured!),
  ...allWork
    .filter((e) => e.data.featured === undefined)
    .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt),
];
const workEntries = orderedWork.slice(0, 4);
const moreWork = orderedWork.slice(4);
/** The award a piece of work won, if any: matched on the award's link, so
    lib/cv.ts stays the one place the award is written down. */
const awardFor = (id: string) => cv.awards.find((a) => a.href === `/work/${id}/`);

---

<Base>
  <Schema
    slot="head"
    data={[personSchema({ knowsAbout: skills.map((s) => s.title) }), websiteSchema()]}
  />
  {/* ── HERO ───────────────────────────────────────────────────────── */}
  {/* The section runs the full width so the rules above and below can cross
      the whole browser; the panel inside stays on the shell measure, level
      with the nav and with the rails further down. */}
  <section class="pt-5 sm:pt-7 flex flex-col gap-3 sm:gap-4">
    <div class="rule-dashed" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-shell px-6 lg:px-10">
      <div class="relative isolate flex flex-col justify-end min-h-[26rem] overflow-hidden rounded-[20px] border border-rule">
      {/* Clipped by the box: overflow-hidden plus the radius crops the shader's
          canvas to the rounded corners, and the box is positioned so it counts
          as the containing block for it. */}
      <HeroShader client:load />

      {/* Scrim. The shader's pink drifts under the hero copy, and at its densest
          it drags the secondary line down to roughly 3:1. This holds the type on
          near-solid paper without touching the part of the field you actually
          see, which sits higher up. */}
      <div
        class="absolute inset-0 z-[1] pointer-events-none bg-gradient-to-t from-paper from-0% via-paper/65 via-38% to-transparent to-72%"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 w-full px-6 sm:px-10 lg:px-14 pt-20 sm:pt-28 pb-16 sm:pb-20">
        <div class="grid grid-cols-12 gap-6 lg:gap-10 items-end">
          <div class="hidden lg:block lg:col-span-2"></div>

          <div class="col-span-12 lg:col-span-10 flex flex-col gap-8 sm:gap-10">
            <h1 class="display text-[clamp(3.25rem,11vw,9rem)] lift lift-1">
              <span class="block">Dylan</span>
              <span class="block">Collins<span class="text-accent">.</span></span>
            </h1>

            <div class="flex flex-col gap-6 max-w-2xl">
              <div class="flex flex-col gap-2 lift lift-2">
                <p class="text-lg sm:text-xl text-ink">
                  Full-stack developer in Ireland.
                </p>
                {/* Range first, then what I'm doing now. "Software", not "web
                    platforms": the work runs from servers to native desktop
                    apps. The award line is the claim, not the citation: the
                    award's full name and The B!G Idea are on the first work
                    card, which is the evidence. It went to the platform, not to
                    me, so it qualifies the platform. Shown only while
                    lib/cv.ts lists an award. */}
                <p class="text-base sm:text-lg text-ink-dim">
                  Over ten years of building software, from servers to native
                  desktop apps.
                  {award && (
                    <>
                      {" "}Right now I'm the lead developer on an <a href={award.href ?? "/cv/"} class="ilink"><span class="whitespace-nowrap">award-winning</span> education platform</a>{" "}
                      used in schools across Ireland.
                    </>
                  )}
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-3 lift lift-3">
                <a href="/cv/" class="btn btn-primary">
                  View CV
                  <ArrowIcon />
                </a>
                <a href="/work/" class="btn btn-secondary">
                  See work
                  <ArrowIcon />
                </a>
              </div>

              <OpenToWork detail class="lift lift-4" />
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>

    <div class="rule-dashed" aria-hidden="true"></div>
  </section>

  {/* ── THE RUN ────────────────────────────────────────────────────────
      One continuous framed region rather than five separate sections: the
      rails run unbroken from here to the foot of the page, and the content
      inside is divided by internal breaks. The blocks below are stacked on a
      plain gap for now — that gap is where the break goes once we know what
      it looks like. */}
  <FramedSection class="mt-3 sm:mt-4" minHeight="0">
    <div class="flex flex-col gap-24 sm:gap-32 py-20 sm:py-28">

      {/* ── Selected work ────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Things I've built." />

        {workEntries.length === 0 ? (
          <EmptyState
            message="Case studies are being written up. In the meantime, reach out and I'll send recent samples."
            ctaHref="/contact/"
            ctaLabel="Get in touch"
          />
        ) : (
          <>
            {/* Bento on the same three columns as the skills plate: the lead
                piece across two thirds with the next beside it, then three
                across. Separate cards with air between them, each carrying its
                own border, so the joints belong to the grid as a whole, not to
                every cell. Absolutely positioned, so CornerNodes does not take
                a grid cell. */}
            <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <CornerNodes />
              {workEntries.map((entry, i) => {
                const wide = i === 0;
                /* The lead piece carries the accent fill. Text on it is solid
                   white throughout: on the brand pink only pure white clears
                   4.5:1, 90% white is 4.0:1, so the hierarchy inside this one
                   comes from size and weight rather than tone. */
                const filled = i === 0;
                const award = awardFor(entry.id);
                /* Entries with screenshots carry a stack that fans on hover.
                   Wide cards set it beside the copy on large screens; narrow
                   ones put it above. A wide card with no screenshots (the
                   platform, which belongs to my employer) sets its figures
                   there instead. */
                const images = entry.data.images ?? [];
                const stacked = images.length > 0;
                const highlights = wide && !stacked ? (entry.data.highlights ?? []) : [];
                const side = wide && (stacked || highlights.length > 0);
                const stack = entry.data.stack.slice(0, wide ? 5 : 3);
                return (
                  <a
                    href={`/work/${entry.id}/`}
                    data-reveal
                    style={`--reveal-delay:${i * 0.12}s`}
                    class:list={[
                      "group flex flex-col gap-8 md:min-h-[18rem] rounded-[6px] border p-7 sm:p-8 transition-colors",
                      filled
                        ? "work-lead bg-accent border-accent text-white hover:bg-accent-deep"
                        : "work-card border-rule hover:bg-paper-2",
                      wide && "md:col-span-2",
                    ]}
                  >
                    {filled && (
                      <span class="work-dots" aria-hidden="true"><span class="work-dots-plane"></span></span>
                    )}
                    {stacked && !wide && (
                      <WorkStack images={images} alt={`${entry.data.title}, three views`} onAccent={filled} />
                    )}
                    <div
                      class:list={[
                        "flex flex-col gap-8",
                        side && "lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-14",
                        side && stacked && "lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-10",
                      ]}
                    >
                      <div class="flex flex-col items-start gap-3">
                        {!filled && (
                          <div class="self-stretch flex items-center justify-between gap-4 mb-3 text-[13px] text-ink-faint">
                            <span class="flex items-center gap-2">
                              <CategoryIcon category={entry.data.category} class="work-card-mark" />
                              {entry.data.category}
                            </span>
                            <time class="font-mono text-xs" datetime={entry.data.publishedAt.toISOString().split("T")[0]}>
                              {entry.data.publishedAt.getFullYear()}
                            </time>
                          </div>
                        )}
                        {award && (
                          <span class:list={["chip mb-2", filled ? "chip-award" : "text-ink"]}>
                            <span class="chip-dot" aria-hidden="true"></span>
                            {award.name}, {award.year}
                          </span>
                        )}
                        <h3
                          class:list={[
                            "font-semibold tracking-tight leading-snug m-0",
                            wide
                              ? "text-[clamp(1.5rem,3vw,2.125rem)]"
                              : "text-[clamp(1.25rem,2.2vw,1.5rem)]",
                          ]}
                        >
                          {entry.data.title}
                        </h3>
                        <p
                          class:list={[
                            "leading-relaxed m-0",
                            filled ? "text-white" : "text-ink-dim",
                            wide ? "text-base max-w-xl" : "text-sm",
                          ]}
                        >
                          {entry.data.summary}
                        </p>
                      </div>
                      {stacked && wide && (
                        <WorkStack images={images} alt={`${entry.data.title}, three views`} onAccent={filled} />
                      )}
                      {highlights.length > 0 && (
                        <dl
                          class:list={[
                            "grid gap-x-8 gap-y-6 m-0",
                            highlights.length === 3 ? "grid-cols-3 lg:grid-cols-1 lg:pr-4" : "grid-cols-2 gap-x-10",
                          ]}
                        >
                          {highlights.map((h) => (
                            <div class="flex flex-col gap-1">
                              <dt class="order-2 text-sm">{h.label}</dt>
                              <dd class="order-1 m-0 font-semibold tracking-tight leading-none text-[clamp(2.25rem,4vw,3rem)] tabular-nums">
                                {h.value}
                              </dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>

                    <div class="mt-auto flex items-end justify-between gap-4">
                      <ul class="flex flex-wrap gap-1.5 m-0 p-0 list-none" aria-label="Stack">
                        {stack.map((tech) => (
                          <li class:list={["chip", filled && "chip-on-accent"]}><TechIcon name={tech} />{tech}</li>
                        ))}
                      </ul>
                      <span
                        aria-hidden="true"
                        class:list={[
                          "flex items-center shrink-0 h-[1.625rem] transition-transform group-hover:translate-x-1",
                          filled ? "text-white" : "text-accent",
                        ]}
                      >
                        <ArrowIcon />
                      </span>
                    </div>
                  </a>
                );
              })}
              {/* The archive: the grid's last cell, so the section closes on
                  a card rather than a loose link under it. Dashed and without
                  the cards' lifted surface, so it never reads as a project. */}
              {moreWork.length > 0 && (
                <a
                  href="/work/"
                  data-reveal
                  style={`--reveal-delay:${workEntries.length * 0.12}s`}
                  class="work-card work-all group flex flex-col gap-8 md:min-h-[18rem] rounded-[6px] border p-7 sm:p-8 transition-colors hover:bg-paper-2"
                >
                  <div class="flex flex-col items-start gap-3">
                    <div class="self-stretch flex items-center justify-between gap-4 mb-3 text-[13px] text-ink-faint">
                      <span class="flex items-center gap-2">
                        <CategoryIcon category="Archive" class="work-card-mark" />
                        Archive
                      </span>
                      <span class="font-mono text-xs">{allWork.length} in all</span>
                    </div>
                    <h3 class="font-semibold tracking-tight leading-snug m-0 text-[clamp(1.25rem,2.2vw,1.5rem)]">
                      All projects
                    </h3>
                    <ul class="m-0 p-0 list-none text-sm leading-relaxed text-ink-dim">
                      {moreWork.slice(0, 3).map((e) => <li>{e.data.title}</li>)}
                      {moreWork.length > 3 && <li class="text-ink-faint">and {moreWork.length - 3} more</li>}
                    </ul>
                  </div>
                  <div class="mt-auto flex items-end justify-between gap-4">
                    <span class="text-sm font-medium text-ink">Browse all {allWork.length}</span>
                    <span
                      aria-hidden="true"
                      class="flex items-center shrink-0 h-[1.625rem] text-accent transition-transform group-hover:translate-x-1"
                    >
                      <ArrowIcon />
                    </span>
                  </div>
                </a>
              )}
            </div>
          </>
        )}
      </div>

      {/* ── What I do ────────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader>
          {/* On a phone only the shortest word fits on one line, so the break
              is fixed: otherwise "to" would jump lines as the word changes. */}
          From <RotatingWord client:visible words={["ticket", "schema", "sketch", "prompt", "first commit"]} /> <br class="sm:hidden" />to production<span class="text-accent">.</span>
        </SectionHeader>

        {/* A plate of five skills in two rows: the main one sideways across
            two thirds with the one to notice beside it as an inverted plate,
            then the other three as equal cards. At tablet width the last of
            the three spans the row and turns sideways, so no cell is left
            empty. The stack is left off: the work cards above carry it.
            Cells draw their own bottom and right edge; the container
            supplies the top and left, so the box closes at any column count. */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 border-t border-l border-rule">
          <SkillCard skill={bySlug("app")} variant="lead" />
          <SkillCard skill={bySlug("ai")} variant="highlight" />
          <SkillCard skill={bySlug("website")} />
          <SkillCard skill={bySlug("automation")} />
          <SkillCard skill={bySlug("hosting")} fill />
        </div>
      </div>

      {/* ── Experience ───────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Where I've done it." />
        <ExperiencePlate />
      </div>

      {/* ── In someone else's words ──────────────────────────────────────
          Straight after the experience, so the last thing before the close
          is someone else vouching for it. Only quotes the person has cleared
          (see lib/endorsements.ts); with none cleared, the block is gone. */}
      {endorsement && <Endorsement endorsement={endorsement} />}

      {/* ── Now ──────────────────────────────────────────────────────── */}
      <div data-reveal>
        <SectionHeader title="Right now." />
        <NowPlate />
      </div>

    </div>
  </FramedSection>

</Base>

<script>
  // The lead work card's dot field in three.js (scripts/workDots.ts), loaded
  // only where it can be used: a fine pointer that hovers, without reduced
  // motion. Everything else keeps the CSS dots, and the other cards' still.
  const dots = document.querySelector<HTMLElement>(".work-dots");
  const able =
    window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (dots && able) {
    import("../scripts/workDots").then(({ mount }) => mount(dots)).catch(() => {});
  }

  // The other work cards' halftone parallax (.work-card in global.css): the
  // pointer's place on the card, from -0.5 to 0.5 each way, one write a frame.
  // Back to centre on leave, as the dots fade out.
  if (able) {
    document.querySelectorAll<HTMLElement>(".work-card").forEach((card) => {
      let frame = 0;
      let x = 0;
      let y = 0;
      const write = () => {
        frame = 0;
        card.style.setProperty("--px", x.toFixed(3));
        card.style.setProperty("--py", y.toFixed(3));
      };
      card.addEventListener(
        "pointermove",
        (e) => {
          const r = card.getBoundingClientRect();
          x = (e.clientX - r.left) / r.width - 0.5;
          y = (e.clientY - r.top) / r.height - 0.5;
          if (!frame) frame = requestAnimationFrame(write);
        },
        { passive: true },
      );
      card.addEventListener("pointerleave", () => {
        x = 0;
        y = 0;
        if (!frame) frame = requestAnimationFrame(write);
      });
    });
  }
</script>
