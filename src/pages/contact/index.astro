---
import Base from "../../layouts/Base.astro";
import Schema from "../../components/Schema.astro";
import OpenToWork from "../../components/OpenToWork.astro";
import PageHero from "../../components/PageHero.astro";
import FramedSection from "../../components/FramedSection.astro";
import SocialIcon from "../../components/SocialIcon.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { contactPageSchema, breadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";

const pageUrl = new URL("/contact/", site.url).toString();
---

<Base
  title="Contact · Dylan Collins"
  description="Get in touch: email or a quick form, whichever you prefer."
>
  <Schema
    slot="head"
    data={[
      contactPageSchema({ url: pageUrl }),
      breadcrumbSchema([
        { name: "Home", url: site.url + "/" },
        { name: "Contact", url: pageUrl },
      ]),
    ]}
  />
  <PageHero title="Say hi">
    <p class="m-0">
      Hiring, got a question, or just want to say hi? All welcome. Email is
      quickest; the form below lands in the same inbox.
    </p>
    <Fragment slot="actions">
      <a href={`mailto:${site.author.email}`} class="btn btn-primary" rel="author">
        Email me
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.75 3.75h10.5a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1H2.75a1 1 0 0 1-1-1v-6.5a1 1 0 0 1 1-1zM2 4.5l6 4.25 6-4.25" />
        </svg>
      </a>
      <a href="/cv/" class="btn btn-secondary">View CV<ArrowIcon /></a>
    </Fragment>
    {site.hiring.open && <OpenToWork detail slot="after" />}
  </PageHero>

  <FramedSection class="mt-3 sm:mt-4" minHeight="0">
    <div class="py-20 sm:py-28" data-reveal>
      {/* One plate: the direct ways on the left, the form on the right. */}
      <div class="grid grid-cols-1 lg:grid-cols-12 rounded-[6px] border border-rule overflow-hidden">
        <address class="lg:col-span-5 not-italic flex flex-col gap-8 p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-rule">
          <div class="flex flex-col gap-3">
            <p class="m-0 text-[13px] text-ink-faint">Email</p>
            <a
              href={`mailto:${site.author.email}`}
              rel="author"
              class="self-start text-[clamp(1.5rem,3vw,2.25rem)] font-semibold tracking-tight leading-tight text-ink hover:text-accent-text transition-colors break-all"
            >
              {site.author.email}
            </a>
          </div>
          <div class="flex flex-col gap-3">
            <p class="m-0 text-[13px] text-ink-faint">Elsewhere</p>
            <div class="flex flex-wrap gap-2">
              <a href={site.social.github} target="_blank" rel="me noopener" class="btn btn-secondary btn-sm">
                <SocialIcon name="github" class="h-4 w-4 icon-lead" />GitHub
              </a>
              <a href={site.social.linkedin} target="_blank" rel="me noopener" class="btn btn-secondary btn-sm">
                <SocialIcon name="linkedin" class="h-4 w-4 icon-lead" />LinkedIn
              </a>
            </div>
          </div>
          <p class="m-0 mt-auto text-sm leading-relaxed text-ink-dim">
            After the short version of me first? <a href="/cv/" class="ilink">The CV</a> has
            the roles, the dates and the stack, and you can download it from there.
          </p>
        </address>

        <form id="contact-form" action={site.contactEndpoint} method="POST" class="lg:col-span-7 grid gap-6 p-6 sm:p-8 lg:p-10">
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="grid gap-2">
              <span class="text-[13px] text-ink-faint">Name</span>
              <input type="text" name="name" required maxlength="100" autocomplete="name" class="field" />
            </label>
            <label class="grid gap-2">
              <span class="text-[13px] text-ink-faint">Email</span>
              <input type="email" name="email" required maxlength="200" autocomplete="email" class="field" />
            </label>
          </div>
          <label class="grid gap-2">
            <span class="text-[13px] text-ink-faint">Message</span>
            <textarea name="message" rows="6" required maxlength="5000" class="field resize-y"></textarea>
          </label>

          {/* Honeypot: hidden from humans, catches bots. Never fill this. */}
          <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden" hidden>
            <label>
              Company
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed">
              <span data-label>Send</span>
              <ArrowIcon />
            </button>
            <p id="contact-status" role="status" aria-live="polite" class="m-0 text-sm"></p>
          </div>
        </form>
      </div>
    </div>
  </FramedSection>

  <script>
    // Progressive enhancement: intercept the submit, POST JSON to the Worker,
    // and show inline status. Without JS the form still POSTs natively to the
    // Worker (form-encoded), which the Worker also accepts.
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("contact-status");
    const button = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;
    const label = form?.querySelector("[data-label]");

    if (form && status && button && label) {
      const setStatus = (msg: string, tone: "ok" | "err" | "") => {
        status.textContent = msg;
        status.style.color =
          tone === "ok" ? "var(--color-accent-text)" : tone === "err" ? "#f87171" : "var(--color-ink-faint)";
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form));

        button.disabled = true;
        label.textContent = "Sending";
        setStatus("", "");

        try {
          const res = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok) {
            form.reset();
            label.textContent = "Sent";
            setStatus("Got it. I'll be in touch.", "ok");
          } else {
            button.disabled = false;
            label.textContent = "Send";
            setStatus(body.error ?? "Something went wrong. Try again?", "err");
          }
        } catch {
          button.disabled = false;
          label.textContent = "Send";
          setStatus("Network error. Try again?", "err");
        }
      });
    }
  </script>
</Base>

<style>
  /* The form's fields: hairline boxes on the page's second ground, the
     brand pink when they have focus. */
  .field {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--color-rule-strong);
    background: color-mix(in srgb, var(--color-ink) 3%, transparent);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .field:hover {
    border-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }
  .field:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
</style>
