---
/**
 * What I do, at length.
 *
 * The homepage plate is the summary; this is each of the five with room: a
 * heading, then a plate with the schematic on one side (3D on a desktop, as
 * on the homepage, and turning toward you when pointed at) and on the other
 * the line, the claim, what it looks like in practice, the tools, and the
 * pages that back it up. The drawing swaps sides down the page so the five
 * read as a run of spreads. In the homepage's order: the main thing first,
 * then the one to notice. Working with AI carries its method under it.
 * Everything comes from lib/skills.ts.
 */
import Base from "../../layouts/Base.astro";
import Schema from "../../components/Schema.astro";
import PageHero from "../../components/PageHero.astro";
import FramedSection from "../../components/FramedSection.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import SkillSketch from "../../components/SkillSketch.astro";
import StepTrack from "../../components/StepTrack.astro";
import TechIcon from "../../components/TechIcon.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { webPageSchema, breadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";
import { skills, aiLoop } from "../../lib/skills";

const ORDER = ["app", "ai", "website", "automation", "hosting"];
const ordered = [...skills].sort((a, b) => ORDER.indexOf(a.slug) - ORDER.indexOf(b.slug));

const pageUrl = new URL("/skills/", site.url).toString();
const pageTitle = "Skills · Dylan Collins";
const pageDesc =
  "What I do and where I have done it: web apps and platforms, working with AI, front-end, automation and infrastructure.";
---

<Base title={pageTitle} description={pageDesc}>
  <Schema
    slot="head"
    data={[
      webPageSchema({ url: pageUrl, name: pageTitle, description: pageDesc }),
      breadcrumbSchema([
        { name: "Home", url: site.url + "/" },
        { name: "Skills", url: pageUrl },
      ]),
    ]}
  />

  <PageHero title="Skills">
    <p class="m-0">
      Five things I do, what each one looks like in practice, and where on
      this site you can see it. I would sooner show the work than list the
      buzzwords, so every claim here points at something.
    </p>
    <Fragment slot="actions">
      <a href="/cv/" class="btn btn-primary">View CV<ArrowIcon /></a>
      <a href="/work/" class="btn btn-secondary">See work<ArrowIcon /></a>
    </Fragment>
  </PageHero>

  <FramedSection class="mt-3 sm:mt-4" minHeight="0">
    <div class="flex flex-col gap-24 sm:gap-32 py-20 sm:py-28">
      {ordered.map((skill, i) => {
        const flip = i % 2 === 1;
        return (
          <section id={skill.slug} aria-labelledby={`${skill.slug}-title`} class="scroll-mt-28" data-reveal>
            <SectionHeader>
              <span id={`${skill.slug}-title`}>{skill.title}<span class="text-accent">.</span></span>
            </SectionHeader>

            <div class="grid grid-cols-1 lg:grid-cols-12 rounded-[6px] border border-rule overflow-hidden">
              {/* The drawing. Its cell is what the 3D build draws across and
                  turns toward the pointer on. */}
              <div
                class:list={[
                  "lg:col-span-5 flex items-center p-6 sm:p-8 border-b lg:border-b-0 border-rule",
                  flip ? "lg:order-2 lg:border-l" : "lg:border-r",
                ]}
              >
                <SkillSketch slug={skill.slug} class="w-full" />
              </div>

              <div class="lg:col-span-7 flex flex-col gap-6 p-6 sm:p-8 lg:p-10">
                <p class="m-0 text-lg sm:text-xl leading-snug text-ink">{skill.tagline}</p>
                <p class="m-0 text-base leading-relaxed text-ink-dim max-w-2xl">{skill.body}</p>

                <ul class="m-0 p-0 list-none grid sm:grid-cols-2 gap-x-8 gap-y-2.5 max-w-2xl">
                  {skill.practice.map((line) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-ink-dim">
                      <span class="flex h-[1lh] shrink-0 items-center" aria-hidden="true"><span class="h-[5px] w-[5px] bg-accent"></span></span>
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-auto flex flex-col gap-4 border-t border-rule pt-6">
                  <ul class="flex flex-wrap gap-1.5 m-0 p-0 list-none" aria-label="Tools">
                    {skill.tools.map((tool) => <li class="chip"><TechIcon name={tool} />{tool}</li>)}
                  </ul>
                  {skill.proof && (
                    <div class="flex flex-wrap gap-2">
                      {skill.proof.map((p) => (
                        <a href={p.href} class="btn btn-secondary btn-sm">{p.label}<ArrowIcon /></a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* The AI entry carries its method with it, because "I use AI"
                says nothing until it says how. */}
            {skill.slug === "ai" && (
              <div class="mt-3 rounded-[6px] border border-rule p-6 sm:p-8 lg:p-10">
                <h3 class="m-0 mb-7 text-lg font-semibold tracking-tight">How it goes</h3>
                <StepTrack steps={aiLoop} />
              </div>
            )}
          </section>
        );
      })}
    </div>
  </FramedSection>
</Base>
