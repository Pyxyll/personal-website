---
/**
 * All the work, as the homepage shows it: the same cards, all of them.
 *
 * The lead is the homepage's lead, across the top in the brand pink; the
 * rest follow two to a row, so every row is full whatever the count. Order
 * is the homepage's: entries with a `featured` place first, then the newest.
 * Each card says what kind of thing it is, so there are no category headings
 * between them.
 */
import Base from "../../layouts/Base.astro";
import Schema from "../../components/Schema.astro";
import PageHero from "../../components/PageHero.astro";
import FramedSection from "../../components/FramedSection.astro";
import CornerNodes from "../../components/CornerNodes.astro";
import WorkCard from "../../components/WorkCard.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import { getCollection } from "astro:content";
import { collectionPageSchema, breadcrumbSchema } from "../../lib/schema";
import { site } from "../../lib/site";

const all = await getCollection("work");
const entries = [
  ...all.filter((e) => e.data.featured !== undefined).sort((a, b) => a.data.featured! - b.data.featured!),
  ...all.filter((e) => e.data.featured === undefined).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt),
];
const [lead, ...rest] = entries;

const pageUrl = new URL("/work/", site.url).toString();
const pageTitle = "Work · Dylan Collins";
const pageDesc =
  "Things I've built: an award-winning education platform, native desktop apps in Rust, a local AI tool, and the servers they run on.";
---

<Base title={pageTitle} description={pageDesc}>
  <Schema
    slot="head"
    data={[
      collectionPageSchema({ url: pageUrl, name: pageTitle, description: pageDesc }),
      breadcrumbSchema([
        { name: "Home", url: site.url + "/" },
        { name: "Work", url: pageUrl },
      ]),
    ]}
  />

  <PageHero title="Work">
    <p class="m-0">
      Things I've built, at work and for myself: an award-winning platform for
      schools, native desktop apps in Rust, a local AI tool, and the servers
      they all run on.
    </p>
    <Fragment slot="actions">
      <a href="/cv/" class="btn btn-primary">View CV<ArrowIcon /></a>
    </Fragment>
  </PageHero>

  <FramedSection class="mt-3 sm:mt-4" minHeight="0">
    <div class="py-20 sm:py-28">
      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-3">
        <CornerNodes />
        {lead && <WorkCard entry={lead} lead index={0} class="md:col-span-2" />}
        {rest.map((entry, i) => <WorkCard entry={entry} index={(i % 2) + 1} />)}
      </div>
    </div>
  </FramedSection>
</Base>
